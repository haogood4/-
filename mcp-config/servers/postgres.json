{
  "id": "postgres",
  "description": "Supabase Postgres；读取计算器配置、公式版本；写操作仅允许 staging。",
  "deferred": true,
  "deferred_note": "MVP 阶段不接入 Postgres，10-20 个计算器为纯前端计算，无持久化需求；出现真实持久化需求后重新评估",
  "command": "mcp-server-postgres",
  "env_required": ["DATABASE_URL"],
  "tools": {
    "read": ["list_tables", "describe_table", "execute_select"],
    "propose": ["insert_draft", "generate_migration", "generate_seed"],
    "approve": [
      "execute_migration",
      "execute_update_prod",
      "execute_delete_prod"
    ]
  },
  "forbidden_operations": [
    "DROP TABLE",
    "TRUNCATE",
    "UPDATE production_users",
    "DELETE FROM production_*"
  ],
  "examples": [
    {"name": "读取公式版本", "args": { "query": "SELECT id, version FROM formulas ORDER BY updated_at DESC LIMIT 20" }}
  ],
  "audit_required": true
}
