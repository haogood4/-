---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ResultArea from "../../components/ResultArea.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";

const breadcrumbItems = [
  { label: "首页", href: "/" },
  { label: "开发工具" },
  { label: "HTML 实体编码解码" },
];

const faqItems = [
  {
    q: "编码时转义哪些字符？",
    a: "固定转义 5 个 XML 核心字符：与符号 → &amp;、小于号 → &lt;、大于号 → &gt;、双引号 → &quot;、单引号 → &#39;。这是防 XSS 与在 HTML 中安全嵌入文本的最小集合，其他字符保持原样。",
  },
  {
    q: "解码支持哪些实体？",
    a: "十进制（&#169;）与十六进制（&#xA9;）数值实体全部支持；命名实体内置 amp/lt/gt/quot/apos 五个核心，其余 200+ 常用命名实体（希腊字母、数学符号、箭头、标点等）按需从数据文件加载。",
  },
  {
    q: "未知实体会怎么处理？",
    a: "未收录或格式非法的实体（如 &foo;、&#zz;）原样保留不报错，方便对照排查；越界的数值实体会被拒译而非生成损坏字符。",
  },
  {
    q: "处理敏感内容安全吗？",
    a: "安全。编码解码完全在浏览器本地完成，命名实体表虽是独立数据文件，但只含字符映射表，不含你的输入内容。",
  },
];
---

<BaseLayout
  title="HTML 实体编码解码 — 在线转义/还原特殊字符与命名实体"
  description="免费在线 HTML 实体转换工具：编码转义与符号、小于号等五大核心字符防 XSS，解码支持十进制/十六进制数值实体与 200+ 常用命名实体（希腊字母、数学符号、箭头等），浏览器本地处理不上传。"
>
  <main id="main">
    <Breadcrumb items={breadcrumbItems} />
    <h1>HTML 实体编码解码</h1>
    <UsageGuide />
    <p class="lead">转义特殊字符防 XSS · 还原命名/数值实体 · 本地处理。</p>

    <form id="calc-form" class="card" novalidate aria-label="HTML 实体转换表单">
      <div class="field">
        <label for="entity-text">文本内容</label>
        <textarea
          id="entity-text"
          class="field-input"
          rows="5"
          placeholder="编码模式粘贴含 < > & 的 HTML；解码模式粘贴含 &xxx; 实体的文本"
          aria-describedby="field-error-text"></textarea>
        <p class="field-error" id="field-error-text" hidden></p>
      </div>
      <div class="field">
        <label for="entity-mode">处理方向</label>
        <select id="entity-mode" class="field-select">
          <option value="encode" selected>编码（转义特殊字符）</option>
          <option value="decode">解码（还原实体字符）</option>
        </select>
      </div>
      <div class="form-actions">
        <button id="calc-btn" type="submit" class="btn btn-primary">
          开始转换
        </button>
        <button id="reset-btn" type="button" class="btn btn-secondary">
          重置
        </button>
      </div>
    </form>

    <ResultArea />

    <AdContainer />

    <section class="section" aria-labelledby="usage-heading">
      <h2 id="usage-heading">使用说明</h2>
      <ol class="note-list">
        <li>粘贴文本并选择「编码」或「解码」方向。</li>
        <li>编码会把 &amp; &lt; &gt; &quot; &#39; 转为实体；解码会还原数值实体与常用命名实体。</li>
        <li>结果支持一键复制，可安全嵌入 HTML 文档或代码。</li>
      </ol>
    </section>

    <section class="section" aria-labelledby="formula-heading">
      <h2 id="formula-heading">常见实体速查</h2>
      <ul class="formula-list">
        <li class="formula-item">
          <p>
            &amp;amp; ↔ &amp; · &amp;lt; ↔ &lt; · &amp;gt; ↔ &gt; · &amp;quot; ↔
            " · &amp;#39; ↔ '
          </p>
        </li>
        <li class="formula-item">
          <p>
            &amp;copy; ↔ © · &amp;reg; ↔ ® · &amp;trade; ↔ ™ · &amp;alpha; ↔ α ·
            &amp;infin; ↔ ∞ · &amp;rarr; ↔ →
          </p>
        </li>
      </ul>
    </section>

    <FaqSection items={faqItems} />

    <section class="section">
      <h2>相关工具</h2><ul class="tool-list">
        <li><a href="/dev/url-encode/">URL 编码解码</a></li>
        <li><a href="/dev/base64/">Base64 编码解码</a></li>
        <li><a href="/dev/html-entity-cn/">HTML 实体编码解码</a></li>
        <li><a href="/dev/json-formatter/">JSON 格式化/校验</a></li>
      </ul>
    </section>

    <p class="disclaimer">
      转义仅处理字符层面，不能替代输出上下文校验：属性值请保留引号包裹，URL
      上下文还需校验协议白名单。
    </p>

    <CalcJsonLd
      name="HTML 实体编码解码"
      description="免费在线 HTML 实体转换工具：编码转义与符号、小于号等五大核心字符防 XSS，解码支持十进制/十六进制数值实体与 200+ 常用命名实体（希腊字母、数学符号、箭头等），浏览器本地处理不上传。"
      faqItems={faqItems}
    />
  </main>

  <script is:inline type="module" src="/scripts/html-entity-cn-page.js"
  ></script>
</BaseLayout>

<style is:global>
  /* 本页结果为可能多行的文本，允许换行展示 */
  #result-main {
    white-space: pre-wrap;
    word-break: break-all;
  }
</style>
