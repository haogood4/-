---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ResultArea from "../../components/ResultArea.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";

const breadcrumbItems = [
  { label: "首页", href: "/" },
  { label: "开发工具" },
  { label: "JS 压缩/美化工具" },
];

const faqItems = [
  {
    q: "压缩是安全的吗？会不会改变代码逻辑？",
    a: "本工具只做词法级压缩：删除注释与多余空白，token 之间必要处补空格，不做变量重命名、作用域分析或语法改写，因此语义保持不变。正确处理字符串、模板字符串、注释与正则字面量边界。",
  },
  {
    q: "和 Terser/esbuild 相比差在哪？",
    a: "Terser 等会做 AST 级优化（死代码消除、变量缩短、内联），压缩率更高。本工具适合快速看清一段压缩代码（配合美化）或轻量去注释，不用于生产构建产物。",
  },
  {
    q: "正则字面量和除号怎么区分？",
    a: "按前文 token 判定：/ 出现在 = ( , : [ ! ; 或 return、typeof 等关键字之后视为正则字面量，出现在标识符、右括号之后视为除号。极罕见的 `) /regex/` 写法（前一个表达式结束后直接跟正则）会被当作除号，请手动调整。",
  },
  {
    q: "代码会被上传吗？",
    a: "不会。压缩与美化完全在浏览器本地完成，无任何网络请求，可以放心粘贴业务代码。",
  },
];
---

<BaseLayout
  title="JS 压缩/美化工具 — 在线 JavaScript 混淆还原排版（本地运行）"
  description="免费在线 JavaScript 压缩与美化工具：词法级压缩去注释缩空白、一键美化还原换行缩进，正确处理字符串、模板字符串与正则字面量边界，纯浏览器本地处理，代码不上传。"
>
  <main id="main">
    <Breadcrumb items={breadcrumbItems} />
    <h1>JS 压缩/美化工具</h1>
    <UsageGuide />
    <p class="lead">
      词法级压缩 · 一键还原排版 · 字符串/模板/正则安全 · 本地处理。
    </p>

    <form id="calc-form" class="card" novalidate aria-label="JS 处理表单">
      <div class="field">
        <label for="js-source">JavaScript 代码</label>
        <textarea
          id="js-source"
          class="field-input"
          rows="8"
          spellcheck="false"
          placeholder="粘贴 JS 代码，例如 function f(){ return 1; } // demo"
          aria-describedby="field-error-text"></textarea>
        <p class="field-error" id="field-error-text" hidden></p>
      </div>
      <div class="field">
        <label for="js-mode">处理方向</label>
        <select id="js-mode" class="field-select">
          <option value="minify" selected>压缩（去注释与空白）</option>
          <option value="beautify">美化（换行缩进还原）</option>
        </select>
      </div>
      <div class="form-actions">
        <button id="calc-btn" type="submit" class="btn btn-primary">
          开始处理
        </button>
        <button id="reset-btn" type="button" class="btn btn-secondary">
          重置
        </button>
      </div>
    </form>

    <ResultArea />

    <AdContainer />

    <section class="section" aria-labelledby="usage-heading">
      <h2 id="usage-heading">使用说明</h2>
      <ol class="note-list">
        <li>粘贴 JavaScript 代码，选择「压缩」或「美化」。</li>
        <li>压缩会删除注释与多余空白（语义不变）；美化会按 2 空格逐层缩进。</li>
        <li>结果区展示输出与字符数变化，可一键复制。</li>
      </ol>
    </section>

    <section class="section" aria-labelledby="formula-heading">
      <h2 id="formula-heading">处理范围说明</h2>
      <ul class="formula-list">
        <li class="formula-item">
          <p>
            词法扫描器逐字符识别状态：字符串（含转义引号）、模板字符串（整体原样保留，含
            ${} 内嵌表达式）、行/块注释、正则字面量。
          </p>
        </li>
        <li class="formula-item">
          <p>
            美化按 {} 逐层缩进，for (;;) 头部的分号不会换行；不调整运算符间距与变量名。
          </p>
        </li>
      </ul>
    </section>

    <FaqSection items={faqItems} />

    <section class="section">
      <h2>相关工具</h2><ul class="tool-list">
        <li><a href="/dev/json-formatter/">JSON 格式化/校验</a></li>
        <li><a href="/dev/regex-tester/">正则表达式测试工具</a></li>
        <li><a href="/dev/code-diff/">文本差异对比工具</a></li>
        <li><a href="/dev/sql-format-cn/">SQL 格式化工具</a></li>
      </ul>
    </section>

    <p class="disclaimer">
      结果仅供参考：生产构建请使用 Terser/esbuild 等成熟工具链，本工具定位为
      快速查看与轻量处理。
    </p>

    <CalcJsonLd
      name="JS 压缩/美化工具"
      description="免费在线 JavaScript 压缩与美化工具：词法级压缩去注释缩空白、一键美化还原换行缩进，正确处理字符串、模板字符串与正则字面量边界，纯浏览器本地处理，代码不上传。"
      faqItems={faqItems}
    />
  </main>

  <script is:inline type="module" src="/scripts/js-minify-cn-page.js"></script>
</BaseLayout>

<style is:global>
  /* 本页结果为多行代码文本 */
  #result-main {
    white-space: pre-wrap;
    overflow-x: auto;
  }
</style>
