---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";

const breadcrumbItems = [
  { label: "首页", href: "/" },
  { label: "效率工具" },
  { label: "日期格式转换" },
];

const faqItems = [
  {
    q: "支持哪些输入格式？",
    a: "支持 YYYY-MM-DD、YYYY/M/D、YYYY.M.D、20260920 紧凑格式、2026年9月20日 中文格式、带 14:30:00 的日期时间、年在后的 MM/DD/YYYY 与 DD/MM/YYYY（两段均不大于 12 时按美式 MM/DD 处理），以及 10 位秒 / 13 位毫秒的 Unix 时间戳和带 Z 或 ±HH:MM 偏移的 ISO 8601 字符串。",
  },
  {
    q: "时区是怎么处理的？",
    a: "不带时区信息的输入（如 2026-09-20 14:30:00）按你选择的时区挂钟理解；带 Z 或 ±HH:MM 的 ISO 字符串与时间戳是绝对时刻，会换算到所选时区后显示。可选 UTC、北京时间 +8、东京 +9、纽约 -5 或浏览器本地时区。",
  },
  {
    q: "时间戳是秒还是毫秒？",
    a: "输入侧按位数判别：10 位纯数字视为秒、13 位视为毫秒。输出侧同时给出秒与毫秒两个值，接口对接时按需取用。",
  },
  {
    q: "闰年规则是什么？",
    a: "公历年份能被 4 整除且不能被 100 整除，或能被 400 整除的为闰年（如 2024 闰、1900 平、2000 闰）。闰年 2 月 29 日合法，平年则报「日期不存在」；年内天数统计也按闰年 366 天正确计算。",
  },
  {
    q: "输出模板里哪些是占位符？",
    a: "YYYY（四位年）、YY（两位年）、MM/M（月）、DD/D（日）、HH（时）、mm（分）、ss（秒）为占位符，其余字符（含中文、冒号、T 等）原样透传，例如「YYYY年MM月DD日」或「日期: YYYY-MM-DD」。",
  },
];
---

<BaseLayout
  title="日期格式转换 — 多格式日期解析与自定义模板输出"
  description="免费在线日期格式转换工具：自动识别 YYYY-MM-DD、斜杠/点分隔、2026年9月20日、紧凑 20260920、Unix 秒/毫秒时间戳与 ISO 8601 带时区字符串，按模板输出并附星期、年内天数与时间戳，适合开发调试、Excel 报表与接口对接。"
  keywords={[
    "日期格式转换",
    "时间格式转换",
    "ISO8601转换",
    "Unix时间戳转日期",
    "Excel日期格式",
    "日期模板输出",
  ]}
>
  <main id="main">
    <Breadcrumb items={breadcrumbItems} />
    <h1>日期格式转换</h1>
    <UsageGuide />
    <p class="lead">
      粘贴任意常见格式的日期或时间戳，选择输出模板与时区，一键得到目标格式、星期、年内天数与
      Unix 时间戳。
    </p>

    <form id="calc-form" class="card" novalidate aria-label="日期格式转换表单">
      <div class="field">
        <label for="input-raw">输入日期 / 时间戳</label>
        <input
          id="input-raw"
          class="field-input"
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder="如 2026-09-20、2026/9/20、20260920、1700000000、2026-09-20T14:30:00+08:00"
          aria-describedby="field-error-raw input-hint"
        />
        <p class="field-hint" id="input-hint">
          支持分隔符日期、中文年月日、紧凑 8 位、10/13 位 Unix 时间戳与带时区的
          ISO 8601。
        </p>
        <p class="field-error" id="field-error-raw" hidden></p>
      </div>

      <div class="field">
        <label for="select-pattern">输出模板</label>
        <select id="select-pattern" class="field-select">
          <option value="YYYY-MM-DD" selected
            >YYYY-MM-DD（如 2026-09-20）</option
          >
          <option value="YYYY/MM/DD">YYYY/MM/DD（如 2026/09/20）</option>
          <option value="YYYY年MM月DD日"
            >YYYY年MM月DD日（如 2026年09月20日）</option
          >
          <option value="DD-MM-YYYY">DD-MM-YYYY（如 20-09-2026）</option>
          <option value="YYYY-MM-DDTHH:mm:ss"
            >ISO 8601（如 2026-09-20T14:30:00）</option
          >
          <option value="custom">自定义模板…</option>
        </select>
      </div>

      <div class="field" id="custom-pattern-field" hidden>
        <label for="input-pattern">自定义模板</label>
        <input
          id="input-pattern"
          class="field-input mono-input"
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder="可用占位符：YYYY YY MM M DD D HH mm ss，其余字符原样输出"
          aria-describedby="field-error-pattern"
        />
        <p class="field-error" id="field-error-pattern" hidden></p>
      </div>

      <div class="field">
        <label for="select-offset">时区</label>
        <select id="select-offset" class="field-select">
          <option value="utc">UTC（+0）</option>
          <option value="480">北京时间（UTC+8）</option>
          <option value="540">东京时间（UTC+9）</option>
          <option value="-300">纽约时间（UTC-5）</option>
          <option value="local">浏览器本地时区</option>
        </select>
        <p class="field-hint">
          无时区信息的输入按所选时区理解；ISO 带 Z / ±HH:MM
          与时间戳会先换算再显示。
        </p>
      </div>

      <div class="form-actions">
        <button id="calc-btn" type="submit" class="btn btn-primary">
          转换
        </button>
        <button id="reset-btn" type="button" class="btn btn-secondary">
          重置
        </button>
      </div>
    </form>

    <div id="result" class="result" role="status" aria-live="polite">
      <p id="result-empty" class="result-empty">
        输入日期后点击「转换」查看结果
      </p>
      <div id="result-content" hidden>
        <p id="result-caption" class="result-caption"></p>
        <p id="result-main" class="result-main mono-text"></p>
        <p id="result-detail" class="result-process"></p>
        <p id="result-stale-hint" class="result-hint" hidden>
          输入已变更，请重新转换
        </p>
        <div class="result-actions">
          <button
            type="button"
            id="copy-btn"
            class="btn btn-secondary"
            disabled
          >
            复制结果
          </button>
        </div>
      </div>
    </div>

    <p class="disclaimer">
      说明：解析与换算全部在浏览器本地完成，数据不会上传；结果仅供参考，跨时区业务请结合服务端时区规则复核。
    </p>

    <AdContainer />

    <FaqSection items={faqItems} />

    <section class="section">
      <h2>相关工具</h2>
      <ul class="tool-list">
        <li><a href="/dev/timestamp/">Unix 时间戳转换</a></li>
        <li><a href="/daily/date-diff/">日期间隔计算器</a></li>
        <li><a href="/daily/age/">年龄计算器</a></li>
      </ul>
    </section>

    <CalcJsonLd
      name="日期格式转换"
      description="免费在线日期格式转换工具：自动识别 YYYY-MM-DD、斜杠/点分隔、2026年9月20日、紧凑 20260920、Unix 秒/毫秒时间戳与 ISO 8601 带时区字符串，按模板输出并附星期、年内天数与时间戳，适合开发调试、Excel 报表与接口对接。"
      faqItems={faqItems}
    />
  </main>

  <script is:inline type="module" src="/scripts/date-format-page.js"></script>
</BaseLayout>

<style>
  .mono-input {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  }
  .mono-text {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    word-break: break-all;
  }
  .disclaimer {
    font-size: 0.85rem;
    opacity: 0.75;
    margin-top: 1rem;
  }
</style>
