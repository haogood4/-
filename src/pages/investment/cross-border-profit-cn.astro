---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";
const faqItems = [{ q: "净利率？", a: "扣除所有成本与平台费后的利润率。" }, { q: "估算未包含哪些成本？", a: "广告费、退货处理费、VAT/关税、汇损与库存滞销未计入，定价决策时建议额外预留缓冲。" }, { q: "如何管理汇率风险？", a: "常见做法包括远期锁汇、及时结汇与多币种账户收支对冲；具体方案请咨询专业机构。" }];
---
<BaseLayout title="跨境电商利润计算器 — 在线单件净利与净利率估算" description="免费在线跨境电商利润计算器：输入售价、采购成本、运费、平台费率与汇率，即时估算单件毛利与净利率，覆盖美元售价人民币成本的主流核算场景，助力选品定价。" >
  <main id="main">
    <Breadcrumb items={[{label:"首页",href:"/"},{label:"投资专业"},{label:"跨境电商利润计算器"}]} />
    <h1>跨境电商利润计算器</h1>
    <UsageGuide />
    <p class="lead">跨境电商利润估算</p>
    <p class="result-hint"><strong>⚠️ 计算结果仅供参考，不构成投资/理财/税务建议。</strong></p>
    <form id="calc-form" class="card" novalidate>
      <div class="field"><label for="sellingPrice">售价（USD）</label><input id="sellingPrice" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="30" /><p class="field-error" id="field-error-sellingPrice" hidden></p></div>
      <div class="field"><label for="productCost">货成本（USD）</label><input id="productCost" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="5" /><p class="field-error" id="field-error-productCost" hidden></p></div>
      <div class="field"><label for="shippingCost">运费（USD）</label><input id="shippingCost" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="3" /><p class="field-error" id="field-error-shippingCost" hidden></p></div>
      <div class="field"><label for="platformFee">平台费（%）</label><input id="platformFee" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="15" /><p class="field-error" id="field-error-platformFee" hidden></p></div>
      <div class="field"><label for="exchangeRate">汇率（USD→CNY）</label><input id="exchangeRate" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="7.2" /><p class="field-error" id="field-error-exchangeRate" hidden></p></div>
      <div class="form-actions"><button id="calc-btn" type="submit" class="btn btn-primary">计算</button><button id="reset-btn" type="button" class="btn btn-secondary">重置</button></div>
    </form>
    <div id="result" class="result" role="status" aria-live="polite"><p id="result-empty" class="result-empty">填写上方字段后显示结果</p><div id="result-content" hidden><p id="result-caption" class="result-caption"></p><p id="result-main" class="result-main"></p><p id="result-detail" class="result-process"></p><p id="result-stale-hint" class="result-hint" hidden>输入已变更，请重新计算</p><div class="result-actions"><button type="button" id="copy-btn" class="btn btn-secondary" disabled>复制结果</button></div></div></div>
    <AdContainer />
    <FaqSection items={faqItems} />
    <section class="section"><h2>相关工具</h2><ul class="tool-list">
  <li><a href="/investment/amazon-fba-cn/">Amazon FBA 费用计算器</a></li>
  <li><a href="/investment/gross-margin-cn/">毛利率计算器</a></li>
  <li><a href="/finance/currency-exchange-cn/">汇率换算计算器</a></li>
      </ul></section>
  
    <CalcJsonLd name="跨境电商利润计算器" description="免费在线跨境电商利润计算器：输入售价、采购成本、运费、平台费率与汇率，即时估算单件毛利与净利率，覆盖美元售价人民币成本的主流核算场景，助力选品定价。" faqItems={faqItems} />
  </main>
  <script is:inline type="module" src="/scripts/cross-border-profit-cn-page.js"></script>
</BaseLayout>
