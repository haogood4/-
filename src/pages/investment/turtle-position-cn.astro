---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
const faqItems = [{ q: "ATR 周期？", a: "常用 20 日 ATR。" }, { q: "海龟系统的 N 值如何确定？", a: "N 为 20 日 ATR（Wilder 平滑），衡量市场波动；单位头寸 = 账户风险额度 ÷（N × 每点价值）。" }, { q: "加仓规则是什么？", a: "原规则为价格每向有利方向移动 0.5N 加仓 1 个单位，同一市场最多 4 个单位，并受组合风险上限约束。" }];
---
<BaseLayout title="海龟交易法仓位计算器 — 在线 ATR 头寸与风险敞口测算" description="免费在线海龟交易法仓位计算器：按账户权益、ATR 波动值与单笔风险比例计算单位头寸、建议加仓数与最大风险敞口，帮助趋势交易者执行系统化仓位管理。" >
  <main id="main">
    <Breadcrumb items={[{label:"首页",href:"/"},{label:"投资专业"},{label:"海龟交易法仓位计算器"}]} />
    <h1>海龟交易法仓位计算器</h1>
    <p class="lead">海龟交易法仓位计算（基于 ATR）</p>
    <p class="result-hint"><strong>⚠️ 计算结果仅供参考，不构成投资/理财/税务建议。</strong></p>
    <form id="calc-form" class="card" novalidate>
      <div class="field"><label for="accountEquity">账户权益（¥）</label><input id="accountEquity" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="1000000" /><p class="field-error" id="field-error-accountEquity" hidden></p></div>
      <div class="field"><label for="atr">ATR</label><input id="atr" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="2.5" /><p class="field-error" id="field-error-atr" hidden></p></div>
      <div class="field"><label for="riskPercent">单笔风险（%）</label><input id="riskPercent" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="1" /><p class="field-error" id="field-error-riskPercent" hidden></p></div>
      <div class="field"><label for="entryPrice">入场价</label><input id="entryPrice" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="100" /><p class="field-error" id="field-error-entryPrice" hidden></p></div>
      <div class="form-actions"><button id="calc-btn" type="submit" class="btn btn-primary">计算</button><button id="reset-btn" type="button" class="btn btn-secondary">重置</button></div>
    </form>
    <div id="result" class="result" role="status" aria-live="polite"><p id="result-empty" class="result-empty">填写上方字段后显示结果</p><div id="result-content" hidden><p id="result-caption" class="result-caption"></p><p id="result-main" class="result-main"></p><p id="result-detail" class="result-process"></p><p id="result-stale-hint" class="result-hint" hidden>输入已变更，请重新计算</p><div class="result-actions"><button type="button" id="copy-btn" class="btn btn-secondary" disabled>复制结果</button></div></div></div>
    <AdContainer />
    <FaqSection items={faqItems} />
    <section class="section"><h2>相关工具</h2><ul class="tool-list">
  <li><a href="/investment/crypto-position-cn/">加密货币仓位计算器</a></li>
  <li><a href="/investment/futures-margin-cn/">期货保证金计算器</a></li>
  <li><a href="/math/average/">平均值计算器</a></li>
      </ul></section>
  
    <CalcJsonLd name="海龟交易法仓位计算器" description="免费在线海龟交易法仓位计算器：按账户权益、ATR 波动值与单笔风险比例计算单位头寸、建议加仓数与最大风险敞口，帮助趋势交易者执行系统化仓位管理。" faqItems={faqItems} />
  </main>
  <script is:inline type="module" src="/scripts/turtle-position-cn-page.js"></script>
</BaseLayout>
