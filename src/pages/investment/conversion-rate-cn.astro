---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";
const faqItems = [{ q: "行业基准？", a: "电商 2-3%，搜索 5-10%。" }, { q: "微转化和宏转化有什么区别？", a: "宏转化是最终目标（付款/注册），微转化是中间行为（加购/查看详情），分步统计可定位漏斗流失环节。" }, { q: "转化率突然下降先查什么？", a: "先检查页面加载性能与支付链路是否报错，再核对流量结构变化（新渠道低质流量会稀释转化率）。" }];
---
<BaseLayout title="转化率计算器 — 在线 CVR 转化率与转化数换算" description="免费在线转化率计算器：输入访客数与转化数即时计算转化率（CVR），并可反推目标转化所需流量，适用于电商详情页、广告投放与增长漏斗的转化效率分析。" >
  <main id="main">
    <Breadcrumb items={[{label:"首页",href:"/"},{label:"投资专业"},{label:"转化率计算器"}]} />
    <h1>转化率计算器</h1>
    <UsageGuide />
    <p class="lead">转化率</p>
    <p class="result-hint"><strong>⚠️ 计算结果仅供参考，不构成投资/理财/税务建议。</strong></p>
    <form id="calc-form" class="card" novalidate>
      <div class="field"><label for="visits">访客数</label><input id="visits" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="10000" /><p class="field-error" id="field-error-visits" hidden></p></div>
      <div class="field"><label for="conversions">转化数</label><input id="conversions" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="200" /><p class="field-error" id="field-error-conversions" hidden></p></div>
      <div class="form-actions"><button id="calc-btn" type="submit" class="btn btn-primary">计算</button><button id="reset-btn" type="button" class="btn btn-secondary">重置</button></div>
    </form>
    <div id="result" class="result" role="status" aria-live="polite"><p id="result-empty" class="result-empty">填写上方字段后显示结果</p><div id="result-content" hidden><p id="result-caption" class="result-caption"></p><p id="result-main" class="result-main"></p><p id="result-detail" class="result-process"></p><p id="result-stale-hint" class="result-hint" hidden>输入已变更，请重新计算</p><div class="result-actions"><button type="button" id="copy-btn" class="btn btn-secondary" disabled>复制结果</button></div></div></div>
    <AdContainer />
    <FaqSection items={faqItems} />
    <section class="section"><h2>相关工具</h2><ul class="tool-list">
  <li><a href="/investment/roas-cn/">ROAS 计算器</a></li>
  <li><a href="/investment/gross-margin-cn/">毛利率计算器</a></li>
  <li><a href="/math/percentage/">百分比计算器</a></li>
      </ul></section>
  
    <CalcJsonLd name="转化率计算器" description="免费在线转化率计算器：输入访客数与转化数即时计算转化率（CVR），并可反推目标转化所需流量，适用于电商详情页、广告投放与增长漏斗的转化效率分析。" faqItems={faqItems} />
  </main>
  <script is:inline type="module" src="/scripts/conversion-rate-cn-page.js"></script>
</BaseLayout>
