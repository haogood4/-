---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
const faqItems = [{ q: "硬装 vs 软装？", a: "硬装：水电、墙地、吊顶；软装：家具、家电、装饰。" }, { q: "硬装预算包含哪些项目？", a: "拆改、水电、防水、瓦工、木工、油工及瓷砖地板卫浴门窗等主材；家具家电属于软装范畴。" }, { q: "预算应该预留多少余量？", a: "建议预留总额的 10%–20% 作为备用金；水电改造与隐蔽工程是常见的增项来源。" }];
---
<BaseLayout title="装修预算计算器 — 在线硬装软装费用分配估算" description="免费在线装修预算计算器：按建筑面积与装修单价估算总预算，给出硬装 60% 软装 40% 的分配建议与各阶段费用参考，帮助业主控制预算、对比装修公司报价。" >
  <main id="main">
    <Breadcrumb items={[{label:"首页",href:"/"},{label:"装修家居"},{label:"装修预算计算器"}]} />
    <h1>装修预算计算器</h1>
    <p class="lead">免费在线装修预算（硬装 60% + 软装 40%）</p>
    
    <form id="calc-form" class="card" novalidate>
      <div class="field"><label for="area">建筑面积（m²）</label><input id="area" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="90" /><p class="field-error" id="field-error-area" hidden></p></div>
      <div class="field"><label for="perSqm">装修单价（元/m²）</label><input id="perSqm" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="2000" /><p class="field-error" id="field-error-perSqm" hidden></p></div>
      <div class="form-actions"><button id="calc-btn" type="submit" class="btn btn-primary">计算</button><button id="reset-btn" type="button" class="btn btn-secondary">重置</button></div>
    </form>
    <div id="result" class="result" role="status" aria-live="polite"><p id="result-empty" class="result-empty">填写上方字段后显示结果</p><div id="result-content" hidden><p id="result-caption" class="result-caption"></p><p id="result-main" class="result-main"></p><p id="result-detail" class="result-process"></p><p id="result-stale-hint" class="result-hint" hidden>输入已变更，请重新计算</p><div class="result-actions"><button type="button" id="copy-btn" class="btn btn-secondary" disabled>复制结果</button></div></div></div>
    <AdContainer />
    <FaqSection items={faqItems} />
    <section class="section"><h2>相关工具</h2><ul class="tool-list">
  <li><a href="/renovation/floor-area-cn/">房屋面积计算器</a></li>
  <li><a href="/renovation/tile-quantity-cn/">瓷砖数量计算器</a></li>
  <li><a href="/renovation/paint-quantity-cn/">乳胶漆用量计算器</a></li>
      </ul></section>
  
    <CalcJsonLd name="装修预算计算器" description="免费在线装修预算计算器：按建筑面积与装修单价估算总预算，给出硬装 60% 软装 40% 的分配建议与各阶段费用参考，帮助业主控制预算、对比装修公司报价。" faqItems={faqItems} />
  </main>
  <script is:inline type="module" src="/scripts/renovation-budget-cn-page.js"></script>
</BaseLayout>
