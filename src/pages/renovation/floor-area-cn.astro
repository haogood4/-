---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
const faqItems = [{ q: "套内 vs 建筑面积？", a: "建筑面积含公摊；套内更接近实际可用面积。" }, { q: "套内面积怎么量？", a: "逐间测量净长宽相乘再求和；异形空间拆成矩形分块计算，柱体与门洞按实际扣减。" }, { q: "公摊面积包含什么？", a: "电梯井、楼梯间、设备间等公共部分按规则分摊到户，不同楼栋形态公摊率差异较大。" }];
---
<BaseLayout title="房屋面积计算器 — 在线房间面积求和套内面积估算" description="免费在线房屋面积计算器：逐间输入面积自动求和得出套内面积，支持套内与建筑面积换算及公摊率估算，装修报价核对与房产面积验算的实用工具。" >
  <main id="main">
    <Breadcrumb items={[{label:"首页",href:"/"},{label:"装修家居"},{label:"房屋面积计算器"}]} />
    <h1>房屋面积计算器</h1>
    <p class="lead">免费在线各房间面积求和</p>
    
    <form id="calc-form" class="card" novalidate>
      <div class="field"><label for="rooms">各房间面积（m²，逗号或换行分隔）</label><textarea id="rooms" class="field-input" rows="3" placeholder="客厅 30, 卧室 15, 厨房 8"></textarea><p class="field-error" id="field-error-rooms" hidden></p></div>
      <div class="form-actions"><button id="calc-btn" type="submit" class="btn btn-primary">计算</button><button id="reset-btn" type="button" class="btn btn-secondary">重置</button></div>
    </form>
    <div id="result" class="result" role="status" aria-live="polite"><p id="result-empty" class="result-empty">填写上方字段后显示结果</p><div id="result-content" hidden><p id="result-caption" class="result-caption"></p><p id="result-main" class="result-main"></p><p id="result-detail" class="result-process"></p><p id="result-stale-hint" class="result-hint" hidden>输入已变更，请重新计算</p><div class="result-actions"><button type="button" id="copy-btn" class="btn btn-secondary" disabled>复制结果</button></div></div></div>
    <AdContainer />
    <FaqSection items={faqItems} />
    <section class="section"><h2>相关工具</h2><ul class="tool-list">
  <li><a href="/renovation/renovation-budget-cn/">装修预算计算器</a></li>
  <li><a href="/renovation/tile-quantity-cn/">瓷砖数量计算器</a></li>
  <li><a href="/renovation/paint-quantity-cn/">乳胶漆用量计算器</a></li>
      </ul></section>
  
    <CalcJsonLd name="房屋面积计算器" description="免费在线房屋面积计算器：逐间输入面积自动求和得出套内面积，支持套内与建筑面积换算及公摊率估算，装修报价核对与房产面积验算的实用工具。" faqItems={faqItems} />
  </main>
  <script is:inline type="module" src="/scripts/floor-area-cn-page.js"></script>
</BaseLayout>
