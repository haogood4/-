---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";
const faqItems = [
  { q: "尺码对照表怎么用？", a: "先选分类（男装上装 / 女装上装 / 童装上装 / 鞋码），再选号制（中国号、欧洲号、美国号、英国号），选择或填写任一号制的尺码，点击「换算」即可得到四制完整对照与胸围、腰围、脚长参考区间。" },
  { q: "换算结果和我买的品牌尺码表不一致？", a: "各品牌版型与国别标准差异较大（欧美品牌偏大、日韩品牌偏小），本工具为通用参考对照，结果仅供参考，各品牌尺码存在差异，请以实际商品尺码表为准。" },
  { q: "鞋码里的美国号是男码还是女码？", a: "对照表中的美国鞋码为 US Men（男码）。女款美码通常比男码大约 1.5 号（如男 US 7 ≈ 女 US 8.5），女士选鞋建议直接按脚长（厘米）对照脚长列更稳妥。" },
  { q: "童装尺码怎么选？", a: "中国号与欧洲号童装以身高标注（110–160），美码与英码按年龄标注。建议按孩子净身高加 5–10 cm 松量选号，并对照胸围区间；孩子体型差异大时以商品实测尺码为准。" },
  { q: "胸围、腰围怎么测量？", a: "胸围沿胸部最丰满处水平绕一圈，腰围沿腰部最细处水平绕一圈，软尺保持贴合但不勒紧。本工具输出的是人体净尺寸参考区间，服装成品通常另含放松量。" },
  { q: "数据会上传吗？", a: "不会。全部换算在浏览器本地完成，对照表内置于页面脚本，无任何网络请求。" },
];
---
<BaseLayout title="服装尺码对照表在线换算 — 男女装童装鞋码 CN/EU/US/UK 互转" description="免费在线服装尺码对照与换算工具：男装上装、女装上装、童装与鞋码，支持中国号、欧洲号、美国号、英国号四制互查，并给出胸围、腰围与脚长参考区间，本地换算不上传，结果仅供参考，各品牌尺码存在差异，请以实际商品尺码表为准。" >
  <main id="main">
    <Breadcrumb items={[{label:"首页",href:"/"},{label:"日常工具"},{label:"服装尺码对照表"}]} />
    <h1>服装尺码对照表与换算</h1>
    <UsageGuide />
    <p class="lead">男装 / 女装 / 童装 / 鞋码 · 中国号·欧洲号·美国号·英国号四制互查 · 附胸围腰围脚长参考</p>

    <form id="calc-form" class="card" novalidate aria-label="服装尺码换算表单">
      <div class="field">
        <label for="category">分类</label>
        <select id="category" class="field-select">
          <option value="men" selected>男装上装</option>
          <option value="women">女装上装</option>
          <option value="kids">童装上装</option>
          <option value="shoes">鞋码</option>
        </select>
      </div>
      <div class="field">
        <label for="system">号制</label>
        <select id="system" class="field-select">
          <option value="cn" selected>中国号（CN）</option>
          <option value="eu">欧洲号（EU）</option>
          <option value="us">美国号（US）</option>
          <option value="uk">英国号（UK）</option>
        </select>
      </div>
      <div class="field">
        <label for="size-value">尺码值</label>
        <input id="size-value" class="field-input" type="text" autocomplete="off"
          list="size-options" placeholder="选择或填写中国号，如 175" aria-describedby="field-error-size" />
        <datalist id="size-options">
          <option value="165"></option>
          <option value="170"></option>
          <option value="175"></option>
          <option value="180"></option>
          <option value="185"></option>
          <option value="190"></option>
        </datalist>
        <p class="field-hint">也可直接输入字母码，如 S、M、L、XL、2XL（男装 / 女装 / 童装）。</p>
        <p class="field-error" id="field-error-size" hidden></p>
      </div>
      <div class="form-actions">
        <button id="calc-btn" type="submit" class="btn btn-primary">换算</button>
        <button id="reset-btn" type="button" class="btn btn-secondary">重置</button>
      </div>
    </form>

    <div id="result" class="result" role="status" aria-live="polite">
      <p id="result-empty" class="result-empty">选择分类与号制，输入尺码后点击「换算」查看四制对照</p>
      <div id="result-content" hidden>
        <p id="result-caption" class="result-caption"></p>
        <p id="result-main" class="result-main"></p>
        <p id="result-detail" class="result-process"></p>
        <p id="result-stale-hint" class="result-hint" hidden>输入已变更，请重新换算</p>
        <div class="result-actions">
          <button type="button" id="copy-btn" class="btn btn-secondary" disabled>复制完整对照</button>
        </div>
      </div>
    </div>
    <p class="result-hint"><strong>⚠️ 换算结果仅供参考，各品牌尺码存在差异，请以实际商品尺码表为准。</strong></p>

    <AdContainer />
    <FaqSection items={faqItems} />
    <section class="section"><h2>相关工具</h2><ul class="tool-list">
      <li><a href="/daily/age/">年龄计算器</a></li>
      <li><a href="/health/bmi-cn/">BMI 计算器</a></li>
      <li><a href="/unit/length/">长度换算计算器</a></li>
    </ul></section>

    <CalcJsonLd name="服装尺码对照表与换算" description="免费在线服装尺码对照与换算工具：男装上装、女装上装、童装与鞋码，支持中国号、欧洲号、美国号、英国号四制互查，并给出胸围、腰围与脚长参考区间，本地换算不上传，结果仅供参考，各品牌尺码存在差异，请以实际商品尺码表为准。" faqItems={faqItems} />
  </main>
  <script is:inline type="module" src="/scripts/clothing-size-cn-page.js"></script>
</BaseLayout>
