---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
const faqItems = [{ q: "配速单位？", a: "分:秒 / 公里，例如 6'00\" = 6 分钟跑 1 公里。" }, { q: "配速和速度是什么关系？", a: "配速是每公里所需时间（分钟/公里），速度是每小时跑动距离（公里/小时），两者互为倒数；配速 6:00 即时速 10 公里。" }, { q: "如何用配速规划分段成绩？", a: "得到平均配速后按每公里等配速推算分段用时，比赛中对照分段目标保持匀速，避免前快后慢。" }];
---
<BaseLayout title="跑步配速计算器 — 在线配速时速与完赛时间换算" description="免费在线跑步配速计算器：输入距离与完赛时间，即时换算配速（分钟/公里）、时速（公里/小时）与分段用时，帮助跑者设定 5K/10K/半马目标配速并匀速完赛。" >
  <main id="main">
    <Breadcrumb items={[{label:"首页",href:"/"},{label:"健康生活"},{label:"节拍计算器"}]} />
    <h1>节拍计算器</h1>
    <p class="lead">免费在线跑步配速计算器</p>
    <p class="result-hint"><strong>⚠️ 本计算结果仅供参考，不能替代医生诊断；训练计划请结合自身状况并咨询专业教练。</strong></p>
    <form id="calc-form" class="card" novalidate>
      <div class="field"><label for="distance">距离（km）</label><input id="distance" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="5" /><p class="field-error" id="field-error-distance" hidden></p></div>
      <div class="field"><label for="hours">小时</label><input id="hours" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="0" /><p class="field-error" id="field-error-hours" hidden></p></div>
      <div class="field"><label for="minutes">分钟</label><input id="minutes" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="30" /><p class="field-error" id="field-error-minutes" hidden></p></div>
      <div class="field"><label for="seconds">秒</label><input id="seconds" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="0" /><p class="field-error" id="field-error-seconds" hidden></p></div>
      <div class="form-actions"><button id="calc-btn" type="submit" class="btn btn-primary">计算</button><button id="reset-btn" type="button" class="btn btn-secondary">重置</button></div>
    </form>
    <div id="result" class="result" role="status" aria-live="polite"><p id="result-empty" class="result-empty">填写上方字段后显示结果</p><div id="result-content" hidden><p id="result-caption" class="result-caption"></p><p id="result-main" class="result-main"></p><p id="result-detail" class="result-process"></p><p id="result-stale-hint" class="result-hint" hidden>输入已变更，请重新计算</p><div class="result-actions"><button type="button" id="copy-btn" class="btn btn-secondary" disabled>复制结果</button></div></div></div>
    <AdContainer />
    <FaqSection items={faqItems} />
    <section class="section"><h2>相关工具</h2><ul class="tool-list">
  <li><a href="/health/calorie-burn-cn/">卡路里消耗计算器</a></li>
  <li><a href="/health/bmi-cn/">BMI 计算器</a></li>
  <li><a href="/daily/basic/">四则运算计算器</a></li>
      </ul></section>
  
    <CalcJsonLd name="节拍计算器" description="免费在线跑步配速计算器：输入距离与完赛时间，即时换算配速（分钟/公里）、时速（公里/小时）与分段用时，帮助跑者设定 5K/10K/半马目标配速并匀速完赛。" faqItems={faqItems} />
  </main>
  <script is:inline type="module" src="/scripts/pace-cn-page.js"></script>
</BaseLayout>
