---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";
const faqItems = [{ q: "预产期准吗？", a: "实际分娩日期常与预产期有 ±2 周偏差。" }, { q: "为什么孕周从末次月经算起？", a: "排卵日难以精确确定，产科统一以末次月经首日为妊娠起点，因此推算孕周比实际受孕约早 2 周。" }, { q: "预产期有多准？", a: "仅约 5% 的分娩发生在预产期当天；妊娠 37–42 周内分娩均属足月，具体以产检 B 超核对为准。" }];
---
<BaseLayout title="预产期计算器 — 在线末次月经推算预产期与孕周" description="免费在线预产期计算器：按末次月经首日以奈格尔法则推算预产期、当前孕周与关键产检时间点，帮助准妈妈规划孕期检查，结果仅供参考请以 B 超核对为准。" >
  <main id="main">
    <Breadcrumb items={[{label:"首页",href:"/"},{label:"健康生活"},{label:"预产期计算器"}]} />
    <h1>预产期计算器</h1>
    <UsageGuide />
    <p class="lead">免费在线预产期计算</p>
    <p class="result-hint"><strong>⚠️ 估算结果仅供参考，请以产检医生的 B 超核对为准。</strong></p>
    <p class="result-hint"><strong>⚠️ 本计算结果不能替代医生诊断。</strong></p>
    <form id="calc-form" class="card" novalidate>
      <div class="field"><label for="lastPeriod">末次月经日期</label><input id="lastPeriod" class="field-input" type="date" /><p class="field-error" id="field-error-lastPeriod" hidden></p></div>
      <div class="form-actions"><button id="calc-btn" type="submit" class="btn btn-primary">计算</button><button id="reset-btn" type="button" class="btn btn-secondary">重置</button></div>
    </form>
    <div id="result" class="result" role="status" aria-live="polite"><p id="result-empty" class="result-empty">填写上方字段后显示结果</p><div id="result-content" hidden><p id="result-caption" class="result-caption"></p><p id="result-main" class="result-main"></p><p id="result-detail" class="result-process"></p><p id="result-stale-hint" class="result-hint" hidden>输入已变更，请重新计算</p><div class="result-actions"><button type="button" id="copy-btn" class="btn btn-secondary" disabled>复制结果</button></div></div></div>
    <AdContainer />
    <FaqSection items={faqItems} />
    <section class="section"><h2>相关工具</h2><ul class="tool-list">
  <li><a href="/health/ovulation-cn/">排卵期计算器</a></li>
  <li><a href="/daily/date-diff/">日期天数计算器</a></li>
  <li><a href="/daily/age/">年龄计算器</a></li>
      </ul></section>
  
    <CalcJsonLd name="预产期计算器" description="免费在线预产期计算器：按末次月经首日以奈格尔法则推算预产期、当前孕周与关键产检时间点，帮助准妈妈规划孕期检查，结果仅供参考请以 B 超核对为准。" faqItems={faqItems} />
  </main>
  <script is:inline type="module" src="/scripts/due-date-cn-page.js"></script>
</BaseLayout>
