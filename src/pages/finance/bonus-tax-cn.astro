---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";
const faqItems = [{ q: "单独 vs 并入？", a: "2027 年底前可单独计税，通常更优。" }, { q: "年终奖单独计税政策执行到什么时候？", a: "全年一次性奖金单独计税政策已延续至 2027 年 12 月 31 日，申报时请以最新政策为准。" }, { q: "什么是年终奖临界点区间？", a: "按除以 12 确定税率的级距下，存在多发 1 元奖金、到手反而减少的区间，发放时可避开这些跳档点。" }];
---
<BaseLayout title="年终奖个税计算器 — 在线单独计税到手与临界点查询" description="免费在线年终奖个税计算器：按全年一次性奖金单独计税方法自动计算税额与到手金额，支持单独计税与并入综合所得两种方案对比，提示年终奖跳档临界区间。" >
  <main id="main">
    <Breadcrumb items={[{label:"首页",href:"/"},{label:"金融理财"},{label:"年终奖个税计算器"}]} />
    <h1>年终奖个税计算器</h1>
    <UsageGuide />
    <p class="lead">免费在线年终奖个税（单独计税）</p>
    <p class="result-hint"><strong>⚠️ 计算结果仅供参考，不构成投资/理财/税务建议。</strong></p>
    <form id="calc-form" class="card" novalidate>
      <div class="field"><label for="bonus">年终奖金额（¥）</label><input id="bonus" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="36000" /><p class="field-error" id="field-error-bonus" hidden></p></div>
      <div class="form-actions"><button id="calc-btn" type="submit" class="btn btn-primary">计算</button><button id="reset-btn" type="button" class="btn btn-secondary">重置</button></div>
    </form>
    <div id="result" class="result" role="status" aria-live="polite"><p id="result-empty" class="result-empty">填写上方字段后显示结果</p><div id="result-content" hidden><p id="result-caption" class="result-caption"></p><p id="result-main" class="result-main"></p><p id="result-detail" class="result-process"></p><p id="result-stale-hint" class="result-hint" hidden>输入已变更，请重新计算</p><div class="result-actions"><button type="button" id="copy-btn" class="btn btn-secondary" disabled>复制结果</button></div></div></div>
    <AdContainer />
    <FaqSection items={faqItems} />
    <section class="section"><h2>相关工具</h2><ul class="tool-list">
  <li><a href="/finance/income-tax-cn/">个税计算器</a></li>
  <li><a href="/finance/social-insurance-cn/">五险一金计算器</a></li>
  <li><a href="/finance/deposit-interest-cn/">存款利息计算器</a></li>
      </ul></section>
  
    <CalcJsonLd name="年终奖个税计算器" description="免费在线年终奖个税计算器：按全年一次性奖金单独计税方法自动计算税额与到手金额，支持单独计税与并入综合所得两种方案对比，提示年终奖跳档临界区间。" faqItems={faqItems} />
  </main>
  <script is:inline type="module" src="/scripts/bonus-tax-cn-page.js"></script>
</BaseLayout>
