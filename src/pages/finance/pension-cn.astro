---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";
const faqItems = [{ q: "养老金构成？", a: "基础养老金 + 个人账户养老金；本工具为简化估算。" }, { q: "养老金最低缴费年限是如何调整的？", a: "自 2030 年 1 月 1 日起，最低缴费年限由 15 年逐步提高至 20 年，每年提高 6 个月。" }, { q: "估算结果为什么可能与实际差距较大？", a: "本工具按输入的社平工资与缴费基数静态估算，未模拟未来工资增长、个人账户记账利率等变动，结果仅供参考。" }];
---
<BaseLayout title="养老金计算器 — 在线退休工资估算与缴费规划" description="免费在线养老金计算器：输入当前年龄、退休年龄、月薪与当地社平工资，按基础养老金加个人账户公式估算退休后月领金额，辅助规划社保缴费基数与年限。" >
  <main id="main">
    <Breadcrumb items={[{label:"首页",href:"/"},{label:"金融理财"},{label:"养老金计算器"}]} />
    <h1>养老金计算器</h1>
    <UsageGuide />
    <p class="lead">免费在线养老金估算</p>
    <p class="result-hint"><strong>⚠️ 计算结果仅供参考，不构成投资/理财/税务建议。</strong></p>
    <form id="calc-form" class="card" novalidate>
      <div class="field"><label for="currentAge">当前年龄</label><input id="currentAge" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="30" /><p class="field-error" id="field-error-currentAge" hidden></p></div>
      <div class="field"><label for="retireAge">退休年龄</label><input id="retireAge" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="60" /><p class="field-error" id="field-error-retireAge" hidden></p></div>
      <div class="field"><label for="monthlySalary">当前月薪（¥）</label><input id="monthlySalary" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="10000" /><p class="field-error" id="field-error-monthlySalary" hidden></p></div>
      <div class="field"><label for="cityAvgSalary">当地社平工资（¥）</label><input id="cityAvgSalary" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="8000" /><p class="field-error" id="field-error-cityAvgSalary" hidden></p></div>
      <div class="form-actions"><button id="calc-btn" type="submit" class="btn btn-primary">计算</button><button id="reset-btn" type="button" class="btn btn-secondary">重置</button></div>
    </form>
    <div id="result" class="result" role="status" aria-live="polite"><p id="result-empty" class="result-empty">填写上方字段后显示结果</p><div id="result-content" hidden><p id="result-caption" class="result-caption"></p><p id="result-main" class="result-main"></p><p id="result-detail" class="result-process"></p><p id="result-stale-hint" class="result-hint" hidden>输入已变更，请重新计算</p><div class="result-actions"><button type="button" id="copy-btn" class="btn btn-secondary" disabled>复制结果</button></div></div></div>
    <AdContainer />
    <FaqSection items={faqItems} />
    <section class="section"><h2>相关工具</h2><ul class="tool-list">
  <li><a href="/finance/income-tax-cn/">个税计算器</a></li>
  <li><a href="/finance/social-insurance-cn/">五险一金计算器</a></li>
  <li><a href="/finance/compound-interest-cn/">复利计算器</a></li>
      </ul></section>
  
    <CalcJsonLd name="养老金计算器" description="免费在线养老金计算器：输入当前年龄、退休年龄、月薪与当地社平工资，按基础养老金加个人账户公式估算退休后月领金额，辅助规划社保缴费基数与年限。" faqItems={faqItems} />
  </main>
  <script is:inline type="module" src="/scripts/pension-cn-page.js"></script>
</BaseLayout>
