---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
const faqItems = [{ q: "单利 vs 复利？", a: "单利仅本金产生利息；复利将每期利息加入下期本金。" },
    { q: "大额存单？", a: "通常 20 万起，年利率高于普通定期 30-50bp。" }, { q: "定期存款提前支取怎么计息？", a: "提前支取部分一般按支取日挂牌活期利率计息，剩余部分按原利率、原到期日继续计息。" }, { q: "存款保险限额是多少？", a: "《存款保险条例》下同一家银行单个存款人本金加利息最高偿付 50 万元。" }];
---
<BaseLayout title="存款利息计算器 — 在线定期存款整存整取利息试算" description="免费在线存款利息计算器：输入本金、年利率与存期，即时计算利息与到期本息，支持单利/复利两种计息方式与大额存单对比，储蓄与存钱规划一目了然。" >
  <main id="main">
    <Breadcrumb items={[{label:"首页",href:"/"},{label:"金融理财"},{label:"存款利息计算器"}]} />
    <h1>存款利息计算器</h1>
    <p class="lead">免费在线存款利息计算器（单利/复利）</p>
    <p class="result-hint"><strong>⚠️ 计算结果仅供参考，不构成投资/理财/税务建议。</strong></p>
    <form id="calc-form" class="card" novalidate>
      <div class="field"><label for="principal">本金（¥）</label><input id="principal" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="100000" /><p class="field-error" id="field-error-principal" hidden></p></div>
      <div class="field"><label for="rate">年利率（%）</label><input id="rate" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="3" /><p class="field-error" id="field-error-rate" hidden></p></div>
      <div class="field"><label for="years">存期（年）</label><input id="years" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="3" /><p class="field-error" id="field-error-years" hidden></p></div>
      <div class="field"><label for="type">计息方式</label><select id="type" class="field-select"><option value="compound">复利</option><option value="simple">单利</option></select></div>
      <div class="form-actions"><button id="calc-btn" type="submit" class="btn btn-primary">计算</button><button id="reset-btn" type="button" class="btn btn-secondary">重置</button></div>
    </form>
    <div id="result" class="result" role="status" aria-live="polite"><p id="result-empty" class="result-empty">填写上方字段后显示结果</p><div id="result-content" hidden><p id="result-caption" class="result-caption"></p><p id="result-main" class="result-main"></p><p id="result-detail" class="result-process"></p><p id="result-stale-hint" class="result-hint" hidden>输入已变更，请重新计算</p><div class="result-actions"><button type="button" id="copy-btn" class="btn btn-secondary" disabled>复制结果</button></div></div></div>
    <AdContainer />
    <FaqSection items={faqItems} />
    <section class="section"><h2>相关工具</h2><ul class="tool-list">
  <li><a href="/finance/compound-interest-cn/">复利计算器</a></li>
  <li><a href="/finance/annualized-return-cn/">年化收益率</a></li>
  <li><a href="/finance/loan-cn/">贷款计算器</a></li>
      </ul></section>
  
    <CalcJsonLd name="存款利息计算器" description="免费在线存款利息计算器：输入本金、年利率与存期，即时计算利息与到期本息，支持单利/复利两种计息方式与大额存单对比，储蓄与存钱规划一目了然。" faqItems={faqItems} />
  </main>
  <script is:inline type="module" src="/scripts/deposit-interest-cn-page.js"></script>
</BaseLayout>
