---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ResultArea from "../../components/ResultArea.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";

const breadcrumbItems = [
  { label: "首页", href: "/" },
  { label: "角度换算计算器" },
];

const faqItems = [
  {
    q: "度和弧度怎么换算？",
    a: "半圆的 π 弧度等于 180°，因此 1° = π/180 rad ≈ 0.017453 rad，1 rad = 180/π° ≈ 57.29578°。数学与物理公式中的角度一律使用弧度。",
  },
  {
    q: "90° 等于多少弧度？",
    a: "90° = π/2 ≈ 1.570796 rad；45° = π/4 ≈ 0.785398 rad；180° = π ≈ 3.141593 rad。常用特殊角建议记住 π 分数形式。",
  },
  {
    q: "角分、角秒、梯度是什么单位？",
    a: "1° = 60 角分（′），1 角分 = 60 角秒（″），天文观测与大地测绘常用；梯度（gon）是直角 = 100 gon 的欧洲工程用法，1 gon = 0.9°；1 圈（turn）= 360°。",
  },
  {
    q: "换算精度如何？",
    a: "结果按四舍五入保留最多 6 位小数，超出部分以「约」标注；输入数值须在 0 ~ 1e15 之间。数学作业、工程测量、CAD 绘图场景精度完全够用。",
  },
];
---

<BaseLayout
  title="角度换算计算器 — 度、弧度、角分角秒在线互转"
  description="免费在线角度单位换算器：度（°）、弧度（rad）、梯度（gon）、角分、角秒、圈一键互转，数学作业、工程测量、CAD 绘图与天文观测常用的角度换算即输即得。"
>
  <main id="main">
    <Breadcrumb items={breadcrumbItems} />
    <h1>角度换算计算器</h1>
    <UsageGuide />
    <p class="lead">
      度 / 弧度 / 梯度 / 角分 / 角秒 / 圈，6 个角度单位互转。
    </p>

    <form id="calc-form" class="card" novalidate aria-label="角度换算表单">
      <div class="field">
        <label for="input-value">数值</label>
        <input
          id="input-value"
          class="field-input"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          placeholder="例如 180"
          aria-describedby="field-error-value"
        />
        <p class="field-error" id="field-error-value" hidden></p>
      </div>
      <div class="field">
        <label for="input-from">从</label>
        <select id="input-from" class="field-select">
          <option value="deg">度 (°)</option>
          <option value="rad">弧度 (rad)</option>
          <option value="gon">梯度 (gon)</option>
          <option value="arcmin">角分 (′)</option>
          <option value="arcsec">角秒 (″)</option>
          <option value="turn">圈 (turn)</option>
        </select>
      </div>
      <div class="field">
        <label for="input-to">到</label>
        <select id="input-to" class="field-select">
          <option value="rad">弧度 (rad)</option>
          <option value="deg">度 (°)</option>
          <option value="gon">梯度 (gon)</option>
          <option value="arcmin">角分 (′)</option>
          <option value="arcsec">角秒 (″)</option>
          <option value="turn">圈 (turn)</option>
        </select>
      </div>
      <div class="form-actions">
        <button id="calc-btn" type="submit" class="btn btn-primary">
          换算
        </button>
        <button id="reset-btn" type="button" class="btn btn-secondary">
          重置
        </button>
      </div>
    </form>

    <ResultArea />

    <AdContainer />

    <section class="section" aria-labelledby="usage-heading">
      <h2 id="usage-heading">使用说明</h2>
      <ol class="note-list">
        <li>填入数值；「从」选择原始单位；「到」选择目标单位。</li>
        <li>点击「换算」查看结果与公式代入过程。</li>
        <li>换算结果仅供参考，测绘与工程放样请以专业仪器测量结果为准。</li>
      </ol>
    </section>

    <section class="section" aria-labelledby="formula-heading">
      <h2 id="formula-heading">换算公式</h2>
      <ul class="formula-list">
        <li class="formula-item">
          <p>以「度」为基准：1 弧度 = 180/π° ≈ 57.29578°、1 梯度 = 0.9°、1 角分 = 1/60°、1 角秒 = 1/3600°、1 圈 = 360°。</p>
        </li>
        <li class="formula-item">
          <p><strong>换算</strong>：目标值 = 数值 × 原单位因子 ÷ 目标单位因子</p>
          <p>例：<code>180 × 1 ÷ 57.29578 = 约 3.141593</code>（180 度 → 弧度，即 π）</p>
        </li>
      </ul>
    </section>

    <FaqSection items={faqItems} />

    <section class="section"><h2>相关工具</h2><ul class="tool-list">
  <li><a href="/unit/length/">长度单位换算器</a></li>
  <li><a href="/unit/time/">时间单位换算计算器</a></li>
  <li><a href="/unit/speed/">速度换算计算器</a></li>
  <li><a href="/unit/area/">面积换算计算器</a></li>
      </ul></section>

    <CalcJsonLd name="角度换算计算器" description="免费在线角度单位换算器：度（°）、弧度（rad）、梯度（gon）、角分、角秒、圈一键互转，数学作业、工程测量、CAD 绘图与天文观测常用的角度换算即输即得。" faqItems={faqItems} />
  </main>

  <script is:inline type="module" src="/scripts/angle-page.js"></script>
</BaseLayout>
