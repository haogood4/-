---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ResultArea from "../../components/ResultArea.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";

const breadcrumbItems = [
  { label: "首页", href: "/" },
  { label: "长度换算计算器" },
];

const faqItems = [
  {
    q: "支持哪些单位？",
    a: "公制：米 / 厘米 / 毫米 / 千米；英制：英寸 / 英尺 / 码 / 英里；共 8 个单位互转。",
  },
  {
    q: "换算系数是什么？",
    a: "以 1 米为基准：1 英寸 = 0.0254 m、1 英尺 = 0.3048 m、1 码 = 0.9144 m、1 英里 = 1609.344 m。",
  },
  {
    q: "数值必须大于 0 吗？",
    a: "是的。本工具按物理量换算，0 与负数没有意义，会被拒绝。",
  },
  {
    q: "可以用来算屏幕尺寸吗？",
    a: "本工具仅做长度单位换算。屏幕尺寸（英寸）请直接选择「英寸」作为输入或输出单位。",
  },
];
---

<BaseLayout
  title="长度单位换算器 — 在线米厘米英尺英寸互转"
  description="免费在线长度单位换算器：米、厘米、毫米、公里、英寸、英尺、码等常用单位一键互转，覆盖公制与英制，适合身高换算、海淘尺寸核对与工程图纸读量。"
>
  <main id="main">
    <Breadcrumb items={breadcrumbItems} />
    <h1>长度换算计算器</h1>
    <p class="lead">
      公制与英制 8 个长度单位互转：米 / 厘米 / 毫米 / 千米 / 英寸 / 英尺 / 码 / 英里。
    </p>

    <form id="calc-form" class="card" novalidate aria-label="长度换算表单">
      <div class="field">
        <label for="input-value">数值</label>
        <input
          id="input-value"
          class="field-input"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          placeholder="例如 1"
          aria-describedby="field-error-value"
        />
        <p class="field-error" id="field-error-value" hidden></p>
      </div>
      <div class="field">
        <label for="input-from">从</label>
        <select id="input-from" class="field-select">
          <option value="m">米 (m)</option>
          <option value="cm">厘米 (cm)</option>
          <option value="mm">毫米 (mm)</option>
          <option value="km">千米 (km)</option>
          <option value="in">英寸 (in)</option>
          <option value="ft">英尺 (ft)</option>
          <option value="yd">码 (yd)</option>
          <option value="mi">英里 (mi)</option>
        </select>
      </div>
      <div class="field">
        <label for="input-to">到</label>
        <select id="input-to" class="field-select">
          <option value="cm">厘米 (cm)</option>
          <option value="m">米 (m)</option>
          <option value="mm">毫米 (mm)</option>
          <option value="km">千米 (km)</option>
          <option value="in">英寸 (in)</option>
          <option value="ft">英尺 (ft)</option>
          <option value="yd">码 (yd)</option>
          <option value="mi">英里 (mi)</option>
        </select>
      </div>
      <div class="form-actions">
        <button id="calc-btn" type="submit" class="btn btn-primary">
          换算
        </button>
        <button id="reset-btn" type="button" class="btn btn-secondary">
          重置
        </button>
      </div>
    </form>

    <ResultArea />

    <AdContainer />

    <section class="section" aria-labelledby="usage-heading">
      <h2 id="usage-heading">使用说明</h2>
      <ol class="note-list">
        <li>填入数值；「从」选择原始单位；「到」选择目标单位。</li>
        <li>点击「换算」查看结果与公式代入过程。</li>
      </ol>
    </section>

    <section class="section" aria-labelledby="formula-heading">
      <h2 id="formula-heading">换算公式</h2>
      <ul class="formula-list">
        <li class="formula-item">
          <p>以「米」为基准：1 英寸 = 0.0254 m、1 英尺 = 0.3048 m、1 码 = 0.9144 m、1 英里 = 1609.344 m。</p>
        </li>
        <li class="formula-item">
          <p><strong>换算</strong>：目标值 = 数值 × 原单位因子 ÷ 目标单位因子</p>
          <p>例：<code>1 × 1609.344 ÷ 1 = 1609.344</code>（1 英里 → 米）</p>
        </li>
      </ul>
    </section>

    <FaqSection items={faqItems} />

    <section class="section"><h2>相关工具</h2><ul class="tool-list">
  <li><a href="/unit/temperature/">温度单位换算器</a></li>
  <li><a href="/math/ratio/">比例计算器</a></li>
  <li><a href="/daily/basic/">四则运算计算器</a></li>
      </ul></section>
  
    <CalcJsonLd name="长度换算计算器" description="免费在线长度单位换算器：米、厘米、毫米、公里、英寸、英尺、码等常用单位一键互转，覆盖公制与英制，适合身高换算、海淘尺寸核对与工程图纸读量。" faqItems={faqItems} />
  </main>

  <script is:inline type="module" src="/scripts/length-page.js"></script>
</BaseLayout>