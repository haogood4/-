---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ResultArea from "../../components/ResultArea.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";

const breadcrumbItems = [
  { label: "首页", href: "/" },
  { label: "重量换算计算器" },
];

const faqItems = [
  {
    q: "支持哪些单位？",
    a: "公制：毫克 / 克 / 千克 / 吨；英制：磅 / 盎司；市制：斤 / 两；共 8 个重量单位互转。",
  },
  {
    q: "斤、两是市制单位吗？",
    a: "是的。1 斤 = 0.5 千克、1 两 = 50 克，属于我国法定市制计量单位；本工具按此精确比例与公制互转，不是近似值。",
  },
  {
    q: "1 磅等于多少公斤？",
    a: "1 磅（lb）= 0.45359237 千克，为国际磅的精确定义；1 盎司（oz）= 1/16 磅 = 28.349523125 克。",
  },
  {
    q: "换算精度如何？",
    a: "结果按四舍五入保留最多 6 位小数，超出部分以「约」标注；输入数值须在 0 ~ 1e15 之间。日常买菜、海淘、快递计重场景下精度完全够用。",
  },
];
---

<BaseLayout
  title="重量换算计算器 — 千克克吨斤两磅盎司在线互转"
  description="免费在线重量单位换算器：千克、克、吨、斤、两、磅、盎司一键互转，公制、英制、市制全覆盖，买菜称重、海淘包裹核对、快递计重换算都用得上。"
>
  <main id="main">
    <Breadcrumb items={breadcrumbItems} />
    <h1>重量换算计算器</h1>
    <UsageGuide />
    <p class="lead">
      公制、英制、市制 8 个重量单位互转：毫克 / 克 / 千克 / 吨 / 磅 / 盎司 / 斤 / 两。
    </p>

    <form id="calc-form" class="card" novalidate aria-label="重量换算表单">
      <div class="field">
        <label for="input-value">数值</label>
        <input
          id="input-value"
          class="field-input"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          placeholder="例如 1"
          aria-describedby="field-error-value"
        />
        <p class="field-error" id="field-error-value" hidden></p>
      </div>
      <div class="field">
        <label for="input-from">从</label>
        <select id="input-from" class="field-select">
          <option value="kg">千克 (kg)</option>
          <option value="mg">毫克 (mg)</option>
          <option value="g">克 (g)</option>
          <option value="t">吨 (t)</option>
          <option value="lb">磅 (lb)</option>
          <option value="oz">盎司 (oz)</option>
          <option value="jin">斤</option>
          <option value="liang">两</option>
        </select>
      </div>
      <div class="field">
        <label for="input-to">到</label>
        <select id="input-to" class="field-select">
          <option value="jin">斤</option>
          <option value="kg">千克 (kg)</option>
          <option value="mg">毫克 (mg)</option>
          <option value="g">克 (g)</option>
          <option value="t">吨 (t)</option>
          <option value="lb">磅 (lb)</option>
          <option value="oz">盎司 (oz)</option>
          <option value="liang">两</option>
        </select>
      </div>
      <div class="form-actions">
        <button id="calc-btn" type="submit" class="btn btn-primary">
          换算
        </button>
        <button id="reset-btn" type="button" class="btn btn-secondary">
          重置
        </button>
      </div>
    </form>

    <ResultArea />

    <AdContainer />

    <section class="section" aria-labelledby="usage-heading">
      <h2 id="usage-heading">使用说明</h2>
      <ol class="note-list">
        <li>填入数值；「从」选择原始单位；「到」选择目标单位。</li>
        <li>点击「换算」查看结果与公式代入过程。</li>
        <li>换算结果仅供参考，贸易结算请以法定计量器具检定结果为准。</li>
      </ol>
    </section>

    <section class="section" aria-labelledby="formula-heading">
      <h2 id="formula-heading">换算公式</h2>
      <ul class="formula-list">
        <li class="formula-item">
          <p>以「千克」为基准：1 毫克 = 0.000001 kg、1 克 = 0.001 kg、1 吨 = 1000 kg、1 磅 = 0.45359237 kg、1 盎司 = 0.028349523125 kg、1 斤 = 0.5 kg、1 两 = 0.05 kg。</p>
        </li>
        <li class="formula-item">
          <p><strong>换算</strong>：目标值 = 数值 × 原单位因子 ÷ 目标单位因子</p>
          <p>例：<code>1 × 0.45359237 ÷ 0.5 = 约 0.907185</code>（1 磅 → 斤）</p>
        </li>
      </ul>
    </section>

    <FaqSection items={faqItems} />

    <section class="section"><h2>相关工具</h2><ul class="tool-list">
  <li><a href="/unit/length/">长度单位换算器</a></li>
  <li><a href="/unit/temperature/">温度单位换算器</a></li>
  <li><a href="/math/percentage/">百分比计算器</a></li>
      </ul></section>
  
    <CalcJsonLd name="重量换算计算器" description="免费在线重量单位换算器：千克、克、吨、斤、两、磅、盎司一键互转，公制、英制、市制全覆盖，买菜称重、海淘包裹核对、快递计重换算都用得上。" faqItems={faqItems} />
  </main>

  <script is:inline type="module" src="/scripts/weight-page.js"></script>
</BaseLayout>
