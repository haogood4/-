---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ResultArea from "../../components/ResultArea.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";

const breadcrumbItems = [
  { label: "首页", href: "/" },
  { label: "力换算计算器" },
];

const faqItems = [
  {
    q: "支持哪些力单位？",
    a: "毫牛顿（mN）、牛顿（N）、千牛顿（kN）、千克力（kgf）、克力（gf）、吨力（tf）、磅力（lbf）、达因（dyn），共 8 个单位互转，覆盖工程、材料试验与物理教学场景。",
  },
  {
    q: "1 千克力等于多少牛顿？",
    a: "千克力按国际标准重力加速度定义：1 kgf = 1 kg × 9.80665 m/s² = 9.80665 N。因此 1 N ≈ 0.101972 kgf。日常所说「1 公斤的力」即约 9.8 牛顿。",
  },
  {
    q: "磅力和牛顿怎么换算？",
    a: "1 磅力（lbf）= 1 磅质量（0.45359237 kg，精确定义）× 9.80665 = 4.4482216152605 N ≈ 4.448222 N。英制图纸上的 lbf 数值乘以 4.448 即可粗得牛顿数。",
  },
  {
    q: "达因是什么单位？",
    a: "达因（dyn）是 CGS 制的力单位，1 dyn = 1 g·cm/s² = 0.00001 N。表面张力等老文献常用 mN/m 与 dyn/cm，两者数值恰好相等。",
  },
];
---

<BaseLayout
  title="力换算计算器 — 牛顿、千克力、磅力单位在线互转"
  description="免费在线力单位换算器：牛顿 N、千牛顿、千克力 kgf、克力、吨力、磅力 lbf、达因 dyn 一键互转，按 g₀=9.80665 精确定义换算，附公式代入过程，适合工程与教学。"
>
  <main id="main">
    <Breadcrumb items={breadcrumbItems} />
    <h1>力换算计算器</h1>
    <UsageGuide />
    <p class="lead">
      8 个力单位互转：毫牛顿 / 牛顿 / 千牛顿 / 千克力 / 克力 / 吨力 / 磅力 /
      达因。
    </p>

    <form id="calc-form" class="card" novalidate aria-label="力换算表单">
      <div class="field">
        <label for="input-value">数值</label>
        <input
          id="input-value"
          class="field-input"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          placeholder="例如 1"
          aria-describedby="field-error-value"
        />
        <p class="field-error" id="field-error-value" hidden></p>
      </div>
      <div class="field">
        <label for="input-from">从</label>
        <select id="input-from" class="field-select">
          <option value="n">牛顿 (N)</option>
          <option value="mn">毫牛顿 (mN)</option>
          <option value="kn">千牛顿 (kN)</option>
          <option value="kgf">千克力 (kgf)</option>
          <option value="gf">克力 (gf)</option>
          <option value="tf">吨力 (tf)</option>
          <option value="lbf">磅力 (lbf)</option>
          <option value="dyn">达因 (dyn)</option>
        </select>
      </div>
      <div class="field">
        <label for="input-to">到</label>
        <select id="input-to" class="field-select">
          <option value="kgf">千克力 (kgf)</option>
          <option value="n">牛顿 (N)</option>
          <option value="mn">毫牛顿 (mN)</option>
          <option value="kn">千牛顿 (kN)</option>
          <option value="gf">克力 (gf)</option>
          <option value="tf">吨力 (tf)</option>
          <option value="lbf">磅力 (lbf)</option>
          <option value="dyn">达因 (dyn)</option>
        </select>
      </div>
      <div class="form-actions">
        <button id="calc-btn" type="submit" class="btn btn-primary">
          换算
        </button>
        <button id="reset-btn" type="button" class="btn btn-secondary">
          重置
        </button>
      </div>
    </form>

    <ResultArea />

    <AdContainer />

    <section class="section" aria-labelledby="usage-heading">
      <h2 id="usage-heading">使用说明</h2>
      <ol class="note-list">
        <li>填入数值；「从」选择原始单位；「到」选择目标单位。</li>
        <li>点击「换算」查看结果与公式代入过程。</li>
        <li>
          换算结果仅供参考，结构设计与安全校核请以规范计算和实测数据为准。
        </li>
      </ol>
    </section>

    <section class="section" aria-labelledby="formula-heading">
      <h2 id="formula-heading">换算公式</h2>
      <ul class="formula-list">
        <li class="formula-item">
          <p>
            以「牛顿」为基准：1 mN = 0.001 N、1 kN = 1000 N、1 kgf = 9.80665
            N（g₀ = 9.80665 m/s² 精确定义）、1 gf = 0.00980665 N、1 tf = 9806.65
            N、1 lbf = 4.4482216152605 N、1 dyn = 0.00001 N。
          </p>
        </li>
        <li class="formula-item">
          <p>
            <strong>换算</strong>：目标值 = 数值 × 原单位因子 ÷ 目标单位因子
          </p>
          <p>
            例：<code>1 × 1 ÷ 9.80665 = 约 0.101972</code>（1 牛顿 → 千克力）
          </p>
        </li>
      </ul>
    </section>

    <FaqSection items={faqItems} />

    <section class="section">
      <h2>相关工具</h2><ul class="tool-list">
        <li><a href="/unit/weight/">重量换算计算器</a></li>
        <li><a href="/unit/length/">长度单位换算器</a></li>
        <li><a href="/unit/area/">面积换算计算器</a></li>
        <li><a href="/unit/volume/">体积换算计算器</a></li>
      </ul>
    </section>

    <CalcJsonLd
      name="力换算计算器"
      description="免费在线力单位换算器：牛顿 N、千牛顿、千克力 kgf、克力、吨力、磅力 lbf、达因 dyn 一键互转，按 g₀=9.80665 精确定义换算，附公式代入过程，适合工程与教学。"
      faqItems={faqItems}
    />
  </main>

  <script is:inline type="module" src="/scripts/force-page.js"></script>
</BaseLayout>
