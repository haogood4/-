---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ResultArea from "../../components/ResultArea.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";

const breadcrumbItems = [
  { label: "首页", href: "/" },
  { label: "速度换算计算器" },
];

const faqItems = [
  {
    q: "支持哪些单位？",
    a: "千米每小时 (km/h) / 米每秒 (m/s) / 英尺每秒 (ft/s) / 节 (kn) / 英里每小时 (mph) / 马赫 (Ma)；共 6 个速度单位互转。",
  },
  {
    q: "千米每小时和米每秒怎么换算？",
    a: "1 米每秒 = 3.6 千米每小时。所以 36 km/h = 10 m/s，物理题常用这个整倍关系验算。",
  },
  {
    q: "节和马赫是什么单位？",
    a: "1 节 = 1 海里每小时 = 1.852 km/h，用于航海与航空；马赫是声速倍数，标准大气 15°C 下 1 马赫 ≈ 1234.8 km/h，实际值随高度与气温变化，本工具按该近似值换算。",
  },
  {
    q: "换算精度如何？",
    a: "结果按四舍五入保留最多 6 位小数，超出部分以「约」标注；英里、海里、英尺均按国际精确定义换算（1 英里 = 1609.344 米）。",
  },
];
---

<BaseLayout
  title="速度换算计算器 — 千米每小时米每秒英里节在线互转"
  description="免费在线速度单位换算器：km/h、m/s、mph、节、ft/s、马赫一键互转，车速单位核对、飞行航海节换算、物理作业米每秒换算都用得上。"
>
  <main id="main">
    <Breadcrumb items={breadcrumbItems} />
    <h1>速度换算计算器</h1>
    <UsageGuide />
    <p class="lead">
      6 个速度单位互转：千米每小时 / 米每秒 / 英尺每秒 / 节 / 英里每小时 / 马赫。
    </p>

    <form id="calc-form" class="card" novalidate aria-label="速度换算表单">
      <div class="field">
        <label for="input-value">数值</label>
        <input
          id="input-value"
          class="field-input"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          placeholder="例如 100"
          aria-describedby="field-error-value"
        />
        <p class="field-error" id="field-error-value" hidden></p>
      </div>
      <div class="field">
        <label for="input-from">从</label>
        <select id="input-from" class="field-select">
          <option value="kmh">千米每小时 (km/h)</option>
          <option value="ms">米每秒 (m/s)</option>
          <option value="fts">英尺每秒 (ft/s)</option>
          <option value="kn">节 (kn)</option>
          <option value="mph">英里每小时 (mph)</option>
          <option value="mach">马赫 (Ma)</option>
        </select>
      </div>
      <div class="field">
        <label for="input-to">到</label>
        <select id="input-to" class="field-select">
          <option value="ms">米每秒 (m/s)</option>
          <option value="kmh">千米每小时 (km/h)</option>
          <option value="fts">英尺每秒 (ft/s)</option>
          <option value="kn">节 (kn)</option>
          <option value="mph">英里每小时 (mph)</option>
          <option value="mach">马赫 (Ma)</option>
        </select>
      </div>
      <div class="form-actions">
        <button id="calc-btn" type="submit" class="btn btn-primary">
          换算
        </button>
        <button id="reset-btn" type="button" class="btn btn-secondary">
          重置
        </button>
      </div>
    </form>

    <ResultArea />

    <AdContainer />

    <section class="section" aria-labelledby="usage-heading">
      <h2 id="usage-heading">使用说明</h2>
      <ol class="note-list">
        <li>填入数值；「从」选择原始单位；「到」选择目标单位。</li>
        <li>点击「换算」查看结果与公式代入过程。</li>
        <li>换算结果仅供参考，马赫随大气条件变化；交通安全请以路面限速标识为准。</li>
      </ol>
    </section>

    <section class="section" aria-labelledby="formula-heading">
      <h2 id="formula-heading">换算公式</h2>
      <ul class="formula-list">
        <li class="formula-item">
          <p>以「千米每小时」为基准：1 米每秒 = 3.6、1 英尺每秒 = 1.09728、1 节 = 1.852、1 英里每小时 = 1.609344、1 马赫 ≈ 1234.8（标准大气 15°C）。</p>
        </li>
        <li class="formula-item">
          <p><strong>换算</strong>：目标值 = 数值 × 原单位因子 ÷ 目标单位因子</p>
          <p>例：<code>100 × 1 ÷ 1.609344 = 约 62.137119</code>（100 km/h → mph）</p>
        </li>
      </ul>
    </section>

    <FaqSection items={faqItems} />

    <section class="section"><h2>相关工具</h2><ul class="tool-list">
  <li><a href="/unit/length/">长度单位换算器</a></li>
  <li><a href="/unit/time/">时间换算计算器</a></li>
  <li><a href="/daily/fuel-consumption-cn/">油耗计算器</a></li>
      </ul></section>
  
    <CalcJsonLd name="速度换算计算器" description="免费在线速度单位换算器：km/h、m/s、mph、节、ft/s、马赫一键互转，车速单位核对、飞行航海节换算、物理作业米每秒换算都用得上。" faqItems={faqItems} />
  </main>

  <script is:inline type="module" src="/scripts/speed-page.js"></script>
</BaseLayout>
