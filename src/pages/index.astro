---
import BaseLayout from "../layouts/BaseLayout.astro";
import { ARTICLES } from "../data/articles";
import { HUBS } from "../data/hubs";
import { NAV_CATEGORIES } from "../data/nav";

// P2-13：计数构建期从数据源读取，禁止硬编码
const articleCount = ARTICLES.filter((a) => a.type === "article").length;
const hubCount = HUBS.length;

// SEO 元数据（title ≤60 字符；description 150-160 字符；keywords 8 个不堆砌）
const SITE_NAME = "计算器大全";
const pageTitle = "计算器大全 — 50+ 免费在线计算工具：房贷、个税、汇率、BMI";
const pageDescription =
  "计算器大全提供 50+ 免费在线计算工具：房贷等额本息月供、个税与五险一金到手工资、汇率换算、BMI 体重、复利与基金定投收益、装修瓷砖乳胶漆用量、油耗、日期差与年龄计算，手机电脑通用，打开即用无需注册，输入即时出结果并附计算公式说明与常见问题解答。计算结果仅供参考，金融、税务、健康类请以官方口径为准。立即免费使用！";
const pageKeywords = [
  "计算器",
  "在线计算器",
  "免费计算器",
  "房贷计算器",
  "个税计算器",
  "汇率换算",
  "BMI计算器",
  "计算工具大全",
];

// JSON-LD 结构化数据：WebSite + Organization + 精选工具 ItemList
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("/", Astro.site ?? Astro.url).href + "#website",
      name: SITE_NAME,
      alternateName: "计算器大全网站",
      description: pageDescription,
      url: new URL("/", Astro.site ?? Astro.url).href,
      inLanguage: "zh-CN",
      publisher: { "@id": "#organization" },
    },
    {
      "@type": "Organization",
      "@id": new URL("/", Astro.site ?? Astro.url).href + "#organization",
      name: SITE_NAME,
      url: new URL("/", Astro.site ?? Astro.url).href,
      logo: new URL("/favicon.svg", Astro.site ?? Astro.url).href,
    },
    {
      "@type": "ItemList",
      name: "热门计算工具",
      itemListElement: [
        ["房贷计算器", "/finance/mortgage-cn/"],
        ["个税计算器", "/finance/income-tax-cn/"],
        ["五险一金计算器", "/finance/social-insurance-cn/"],
        ["汇率换算计算器", "/finance/currency-exchange-cn/"],
        ["BMI 计算器", "/health/bmi-cn/"],
        ["基金定投计算器", "/finance/fund-dca-cn/"],
        ["复利计算器", "/finance/compound-interest-cn/"],
        ["四则运算计算器", "/daily/basic/"],
      ].map(([name, url], i) => ({
        "@type": "ListItem",
        position: i + 1,
        name,
        url: new URL(url, Astro.site ?? Astro.url).href,
      })),
    },
  ],
};

// 大陆口径 6 类导航（唯一数据源 src/data/nav.ts，首页与站内搜索共用）
const categories = NAV_CATEGORIES;

// 美化包②：hero 数据条工具总数——构建期由 NAV_CATEGORIES 求和计算，禁止硬编码
const toolCount = categories.reduce((sum, c) => sum + c.tools.length, 0);

// 美化包①：分类线性图标（手绘简单 SVG 内芯，stroke 走 currentColor，装饰性 aria-hidden）
const CATEGORY_ICONS: Record<string, string> = {
  // 金融理财：¥ 铜钱
  finance:
    '<circle cx="12" cy="12" r="9"/><path d="m9 7.5 3 4 3-4M12 11.5V17M9.5 13.5h5M9.5 15.5h5"/>',
  // 健康生活：心形
  health:
    '<path d="M12 20C7 16 4 12.8 4 9.5 4 7 6 5 8.5 5c1.4 0 2.7.7 3.5 1.8C12.8 5.7 14.1 5 15.5 5 18 5 20 7 20 9.5c0 3.3-3 6.5-8 10.5Z"/>',
  // 装修家居：房子
  renovation:
    '<path d="m3 11 9-8 9 8"/><path d="M5.5 9v11h13V9"/><path d="M10 20v-6h4v6"/>',
  // 投资专业：趋势线
  investment: '<path d="m3 17 6-6 4 4 7-7"/><path d="M14 8h6v6"/>',
  // 效率工具：闪电
  efficiency: '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"/>',
  // 日常工具：日历
  daily:
    '<rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M8 3v4M16 3v4M3.5 10.5h17"/>',
  // 知识库：书本
  articles:
    '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/>',
  // 场景指南：地图
  hub: '<path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Z"/><path d="M9 4v14M15 6v14"/>',
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  ogType="website"
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
  <main id="main">
    <section class="hero">
      <h1 class="hero__title">计算器大全</h1>
      <ul class="hero__stats">
        <li><strong>{toolCount}</strong> 个免费工具</li>
        <li>无需注册</li>
        <li>打开即用</li>
        <li>手机电脑通用</li>
      </ul>
      <p class="hero__sub">
        50+
        免费在线计算工具，无需注册，打开即用，输入即时出结果并附计算公式说明。
      </p>
      <nav class="hero__chips" aria-label="热门工具快捷入口">
        <a class="chip chip--finance" href="/finance/mortgage-cn/"> 房贷 </a>
        <a class="chip chip--finance" href="/finance/income-tax-cn/"> 个税 </a>
        <a class="chip chip--finance" href="/finance/social-insurance-cn/">
          五险一金
        </a>
        <a class="chip chip--health" href="/health/bmi-cn/"> BMI </a>
        <a class="chip chip--finance" href="/finance/currency-exchange-cn/">
          汇率换算
        </a>
        <a class="chip chip--daily" href="/daily/basic/"> 计算器 </a>
      </nav>
    </section>
    <!-- P2-10 我的工具：最近使用 + 我的收藏（localStorage，无数据时保持隐藏） -->
    <section class="cat-card" id="my-tools" hidden aria-label="我的工具">
      <div class="cat-card__head">
        <span class="cat-card__dot" aria-hidden="true"></span>
        <h2 class="cat-card__title">我的工具</h2>
      </div>
      <div id="recent-block" hidden>
        <h3 class="calc-hint">最近使用</h3>
        <div class="my-tools__row" id="recent-list"></div>
      </div>
      <div id="fav-block" hidden>
        <h3 class="calc-hint">我的收藏</h3>
        <div class="my-tools__row" id="fav-list"></div>
      </div>
    </section>
    <div class="cat-grid">
      {
        categories.map((category) => (
          <section
            class={`cat-card cat-card--${category.key}`}
            id={category.key}
          >
            <div class="cat-card__head">
              <span class="cat-card__icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  focusable="false"
                  set:html={CATEGORY_ICONS[category.key]}
                />
              </span>
              <h2 class="cat-card__title">{category.name}</h2>
              <span class="cat-card__count">
                {category.tools.length} 个工具
              </span>
            </div>
            <ul class="tool-list">
              {category.tools.map((tool) => (
                <li>
                  <a href={tool.href}>{tool.label}</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      <section class="cat-card" id="articles">
        <div class="cat-card__head">
          <span class="cat-card__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              focusable="false"
              set:html={CATEGORY_ICONS.articles}
            />
          </span>
          <h2 class="cat-card__title">知识库</h2>
          <span class="cat-card__count">{articleCount} 篇</span>
        </div>
        <p class="cat-card__sub">
          概念解释、公式推导、政策解读。配套工具内链，月度更新。
        </p>
        <ul class="tool-list">
          <li><a href="/articles-list/">全部文章</a></li>
          <li>
            <a href="/articles/equal-installment-vs-equal-principal/"
              >等额本息 vs 等额本金</a>
          </li>
          <li>
            <a href="/articles/personal-income-tax-deductions-2026/"
              >个税专项附加扣除 2026</a>
          </li>
          <li>
            <a href="/articles/social-insurance-explained/">五险一金缴费比例</a>
          </li>
          <li>
            <a href="/articles/bmi-standards-cn-vs-who/">BMI 标准双对照</a>
          </li>
          <li>
            <a href="/articles/tile-quantity-calculation/">瓷砖用量计算</a>
          </li>
        </ul>
      </section>
      <section class="cat-card" id="hub">
        <div class="cat-card__head">
          <span class="cat-card__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              focusable="false"
              set:html={CATEGORY_ICONS.hub}
            />
          </span>
          <h2 class="cat-card__title">场景指南</h2>
          <span class="cat-card__count">{hubCount} 个场景</span>
        </div>
        <p class="cat-card__sub">
          真实场景串联 3-7 个工具，按步骤使用，无需组合思考。
        </p>
        <ul class="tool-list">
          <li><a href="/hub/">全部场景</a></li>
          <li><a href="/hub/first-home-buying/">首次买房决策</a></li>
          <li><a href="/hub/renovation-100k/">10 万装修预算</a></li>
          <li><a href="/hub/retirement-30/">30 岁养老金规划</a></li>
          <li><a href="/hub/tax-annual-filing/">个税年度申报</a></li>
          <li><a href="/hub/fitness-fat-loss/">健身减脂</a></li>
        </ul>
      </section>
    </div>
    <p>
      <strong>计算结果仅供参考</strong>
      ，金融、税务、健康类工具不构成任何专业建议，请以官方口径为准。
    </p>
  </main>
</BaseLayout>

<script is:inline type="module" src="/scripts/home-page.js"></script>
