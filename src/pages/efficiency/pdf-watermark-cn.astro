---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ResultArea from "../../components/ResultArea.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import BreadcrumbJsonLd from "../../components/BreadcrumbJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";

const description =
  "在线 PDF 加水印工具：给 PDF 每一页平铺或居中添加自定义文字水印，透明度可调，保护文档版权，本地处理不上传。完整功能开发中，当前提供接口契约与交互流程预览。";

const faqItems = [
  {
    q: "现在能给 PDF 加水印吗？",
    a: "还不能。完整水印功能正在开发中，当前页面提供接口契约与流程预览：可以填写水印文字并调整不透明度体验流程，但文件不会被解析，也不会生成带水印的 PDF。",
  },
  {
    q: "水印会是什么样子？",
    a: "上线后支持在每一页平铺斜向文字水印，透明度 0~1 可调：0.2~0.3 适合「内部资料」类浅淡标注，0.5 以上更醒目，适合作废文件标记。",
  },
  {
    q: "文件会被上传吗？",
    a: "不会。本工具设计为全程浏览器本地处理，当前版本同样不读取、不上传任何文件内容，水印文字也只停留在您的浏览器里。",
  },
  {
    q: "和图片加水印工具有什么区别？",
    a: "本工具针对 PDF 文档逐页叠加水印；若您需要给 PNG/JPEG 图片加文字水印，可使用已上线的图片加水印工具，即刻可用。",
  },
];
---

<BaseLayout
  title="PDF 加水印工具 — 给 PDF 添加文字水印（完整功能开发中）"
  description={description}
>
  <main id="main">
    <Breadcrumb
      items={[
        { label: "首页", href: "/" },
        { label: "效率工具" },
        { label: "PDF 加水印工具" },
      ]}
    />
    <h1>PDF 加水印工具</h1>
    <UsageGuide />
    <p class="lead">
      每页平铺文字水印 · 透明度可调 · 本地处理不上传 · 完整功能开发中
    </p>

    <section class="section" aria-label="功能状态说明">
      <div class="card">
        <p>
          <strong>诚实声明：完整功能开发中，暂提供接口契约。</strong>
          本页当前展示未来版本的操作流程与接口契约，PDF 处理引擎尚未接入，文件不会被解析、加水印或上传。
        </p>
      </div>
    </section>

    <form id="calc-form" class="card" novalidate aria-label="PDF 加水印表单">
      <div class="field">
        <label for="pdf-input">选择 PDF 文件</label>
        <input
          type="file"
          id="pdf-input"
          class="field-input"
          accept="application/pdf,.pdf"
        />
        <p class="field-hint">当前版本不会读取文件内容。</p>
        <p class="field-error" id="field-error-file" hidden></p>
      </div>
      <div class="field">
        <label for="watermark-text">水印文字</label>
        <input
          type="text"
          id="watermark-text"
          class="field-input"
          placeholder="例如：内部资料，请勿外传"
          maxlength="40"
        />
        <p class="field-error" id="field-error-text" hidden></p>
      </div>
      <div class="field">
        <label for="watermark-opacity">不透明度（0 ~ 1，默认 0.3）</label>
        <input
          type="number"
          id="watermark-opacity"
          class="field-input"
          min="0"
          max="1"
          step="0.05"
          value="0.3"
        />
        <p class="field-error" id="field-error-opacity" hidden></p>
      </div>
      <div class="form-actions">
        <button id="calc-btn" type="submit" class="btn btn-primary"
          >添加水印</button
        >
        <button id="reset-btn" type="button" class="btn btn-secondary"
          >重置</button
        >
      </div>
    </form>

    <ResultArea />

    <AdContainer />

    <section class="section" aria-labelledby="usage-heading">
      <h2 id="usage-heading">使用说明（完整功能上线后）</h2>
      <ol class="note-list">
        <li>选择 1 个需要加水印的 PDF 文件。</li>
        <li>填写水印文字并调整不透明度。</li>
        <li>点击「添加水印」，本地处理完成后下载带水印的 PDF。</li>
      </ol>
    </section>

    <FaqSection items={faqItems} />

    <section class="section">
      <h2>相关工具</h2><ul class="tool-list">
        <li>
          <a href="/efficiency/image-watermark-cn/">在线图片加水印工具</a>
        </li>
        <li><a href="/efficiency/pdf-to-image-cn/">PDF 转图片工具</a></li>
        <li><a href="/efficiency/pdf-merge-cn/">PDF 合并工具</a></li>
        <li><a href="/efficiency/pdf-compress-cn/">PDF 压缩工具</a></li>
      </ul>
    </section>

    <CalcJsonLd
      name="PDF 加水印工具"
      description={description}
      faqItems={faqItems}
    />
    <BreadcrumbJsonLd
      items={[
        { name: "首页", href: "/" },
        { name: "效率工具" },
        { name: "PDF 加水印工具" },
      ]}
    />
  </main>

  <script is:inline type="module" src="/scripts/pdf-watermark-cn-page.js"
  ></script>
</BaseLayout>
