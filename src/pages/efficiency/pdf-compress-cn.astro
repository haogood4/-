---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ResultArea from "../../components/ResultArea.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import BreadcrumbJsonLd from "../../components/BreadcrumbJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";

const description =
  "在线 PDF 压缩工具：低/中/高三档压缩 PDF 体积，扫描件与图文文档均适用，本地处理不上传。完整功能开发中，当前提供接口契约与交互流程预览，文件不会被解析或上传。";

const faqItems = [
  {
    q: "现在能压缩 PDF 体积吗？",
    a: "还不能。完整压缩功能正在开发中，当前页面提供接口契约与流程预览：可以选择文件并体验低/中/高三档压缩档位的选择，但文件不会被解析或压缩，也不会产生下载结果。",
  },
  {
    q: "三档压缩有什么区别？",
    a: "低档保真优先，适合合同、报表等文字为主的文档；中档均衡，适合日常分享；高档体积优先，适合扫描件等图片占比大的文件，上线后会展示压缩前后的体积对比。",
  },
  {
    q: "文件会被上传吗？",
    a: "不会。本工具设计为全程浏览器本地处理，当前版本同样不读取、不上传任何文件内容，您可以放心体验流程。",
  },
  {
    q: "和图片压缩工具是什么关系？",
    a: "两者独立：图片压缩针对 PNG/JPEG/WebP 单张图片，本工具针对 PDF 文档整体（内含文字流与图片流的重压缩）。若只是想让 PDF 里的图片变小，也可以先用图片压缩工具处理后再重排。",
  },
];
---

<BaseLayout
  title="PDF 压缩工具 — 在线压缩 PDF 体积（完整功能开发中）"
  description={description}
>
  <main id="main">
    <Breadcrumb
      items={[
        { label: "首页", href: "/" },
        { label: "效率工具" },
        { label: "PDF 压缩工具" },
      ]}
    />
    <h1>PDF 压缩工具</h1>
    <UsageGuide />
    <p class="lead">
      低/中/高三档压缩 PDF 体积 · 本地处理不上传 · 完整功能开发中
    </p>
    <p class="ymyl-notice" role="note">
      <strong>⚖️ 使用须知</strong>：请<strong>仅对您拥有合法权利或已获授权的 PDF</strong>使用本工具。<strong>请勿使用本工具处理他人享有版权的文档、内部资料、个人隐私文件（含他人身份证 / 合同 / 病历 / 票据等）</strong>，避免侵犯他人著作权或个人信息权益。本工具为中立技术工具，PDF 完整功能上线后全程在浏览器本地处理、不上传服务器。
    </p>

    <section class="section" aria-label="功能状态说明">
      <div class="card">
        <p>
          <strong>诚实声明：完整功能开发中，暂提供接口契约。</strong>
          本页当前展示未来版本的操作流程与接口契约，PDF 处理引擎尚未接入，文件不会被解析、压缩或上传。
        </p>
      </div>
    </section>

    <form id="calc-form" class="card" novalidate aria-label="PDF 压缩表单">
      <div class="field">
        <label for="pdf-input">选择 PDF 文件</label>
        <input
          type="file"
          id="pdf-input"
          class="field-input"
          accept="application/pdf,.pdf"
        />
        <p class="field-hint">当前版本不会读取文件内容。</p>
        <p class="field-error" id="field-error-file" hidden></p>
      </div>
      <div class="field">
        <label for="compress-level">压缩档位</label>
        <select id="compress-level" class="field-select">
          <option value="low">低（保真优先，文字清晰）</option>
          <option value="medium" selected>中（推荐，体积与清晰度均衡）</option>
          <option value="high">高（体积优先，适合扫描件）</option>
        </select>
      </div>
      <div class="form-actions">
        <button id="calc-btn" type="submit" class="btn btn-primary"
          >开始压缩</button
        >
        <button id="reset-btn" type="button" class="btn btn-secondary"
          >重置</button
        >
      </div>
    </form>

    <ResultArea />

    <AdContainer />

    <section class="section" aria-labelledby="usage-heading">
      <h2 id="usage-heading">使用说明（完整功能上线后）</h2>
      <ol class="note-list">
        <li>选择 1 个需要压缩的 PDF 文件。</li>
        <li>选择压缩档位，不确定时保持推荐的「中」档。</li>
        <li>点击「开始压缩」，本地压缩完成后查看前后体积对比并下载。</li>
      </ol>
    </section>

    <FaqSection items={faqItems} />

    <section class="section">
      <h2>相关工具</h2><ul class="tool-list">
        <li><a href="/efficiency/pdf-merge-cn/">PDF 合并工具</a></li>
        <li><a href="/efficiency/pdf-split-cn/">PDF 拆分工具</a></li>
        <li><a href="/efficiency/image-compress-cn/">在线图片压缩工具</a></li>
        <li><a href="/efficiency/image-convert-cn/">图片格式转换工具</a></li>
      </ul>
    </section>

    <CalcJsonLd
      name="PDF 压缩工具"
      description={description}
      faqItems={faqItems}
    />
    <BreadcrumbJsonLd
      items={[
        { name: "首页", href: "/" },
        { name: "效率工具" },
        { name: "PDF 压缩工具" },
      ]}
    />
  </main>

  <script is:inline type="module" src="/scripts/pdf-compress-cn-page.js"
  ></script>
</BaseLayout>
