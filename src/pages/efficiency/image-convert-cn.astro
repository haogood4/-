---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";

const description =
  "免费在线图片格式转换：PNG 转 JPEG、JPEG 转 WebP、WebP 转 PNG 一键互转，适合截图、头像、商品图、网页配图等场景，单张不超过 10MB，浏览器本地 Canvas 处理，图片绝不上传服务器。";

const faqItems = [
  {
    q: "图片会上传到服务器吗？",
    a: "不会。转换全程在您的浏览器内用 Canvas 本地完成，图片数据不经过任何服务器，也不会被保存，敏感图片也可放心使用。",
  },
  {
    q: "支持哪些格式之间的互转？",
    a: "支持 PNG、JPEG、WebP 三种格式两两互转（如 PNG 转 WebP、WebP 转 JPEG 等），输入单张不超过 10MB。GIF、BMP、TIFF 等格式暂不支持。",
  },
  {
    q: "PNG 转 JPEG 后透明背景怎么办？",
    a: "JPEG 格式没有透明通道，转换时透明区域会自动垫白底。若需保留透明背景，请选择 WebP 或 PNG 作为目标格式。",
  },
  {
    q: "JPEG 质量怎么选？",
    a: "质量取值 0.5–1.0，默认 0.92。数值越大画质越好、体积越大；网页配图一般 0.8–0.9 即可兼顾清晰度与体积。质量仅对 JPEG / WebP 输出生效，PNG 为无损格式。",
  },
  {
    q: "为什么转换后文件体积变化很大？",
    a: "PNG 转 JPEG / WebP 通常明显变小；JPEG 转 PNG 因改为无损存储往往变大；同格式重编码体积也可能波动。如需压缩体积可搭配图片压缩工具，转换结果仅供参考。",
  },
  {
    q: "转换结果准确吗？",
    a: "转换基于浏览器 Canvas 重绘编码，画质与体积受所选格式、质量参数影响，展示的数据仅供参考；建议预览确认后再用于正式场景。",
  },
];
---

<BaseLayout
  title="图片格式转换：PNG/JPEG/WebP 一键互转（浏览器本地处理不上传）"
  description={description}
>
  <main id="main">
    <Breadcrumb
      items={[
        { label: "首页", href: "/" },
        { label: "效率工具" },
        { label: "图片格式转换" },
      ]}
    />
    <h1>图片格式转换</h1>
    <UsageGuide />
    <p class="lead">PNG / JPEG / WebP 互转 · 浏览器本地处理 · 绝不上传</p>

    <form id="calc-form" class="card" novalidate aria-label="图片格式转换表单">
      <div class="field">
        <label for="file-input">选择图片</label>
        <label class="dropzone" id="dropzone" for="file-input">
          <span class="dropzone__title">把图片拖到这里，或点击选择文件</span>
          <span class="dropzone__hint"
            >支持 PNG / JPEG / WebP，单张不超过 10MB</span
          >
          <input
            type="file"
            id="file-input"
            class="dropzone__input"
            accept="image/png,image/jpeg,image/webp"
          />
        </label>
        <p class="field-hint" id="file-info" hidden></p>
        <p class="field-error" id="field-error-file" hidden></p>
      </div>
      <div class="field">
        <label for="output-format">目标格式</label>
        <select id="output-format" class="field-select">
          <option value="image/jpeg" selected
            >JPEG（透明区域垫白底，体积小）</option
          >
          <option value="image/png">PNG（无损，保留透明通道）</option>
          <option value="image/webp">WebP（保留透明通道，体积小）</option>
        </select>
      </div>
      <div class="field">
        <label for="quality-range"
          >JPEG 质量（0.5 – 1.0，默认 0.92，仅对 JPEG / WebP 生效）</label
        >
        <div class="quality-row">
          <input
            type="range"
            id="quality-range"
            min="0.5"
            max="1"
            step="0.01"
            value="0.92"
            aria-label="JPEG 质量滑块"
          />
          <span class="quality-value" id="quality-value">0.92</span>
        </div>
        <p class="field-error" id="field-error-quality" hidden></p>
      </div>
      <div class="form-actions">
        <button id="calc-btn" type="submit" class="btn btn-primary"
          >开始转换</button
        >
        <button id="reset-btn" type="button" class="btn btn-secondary"
          >重置</button
        >
      </div>
    </form>

    <div class="card" id="preview-card">
      <div class="preview-grid">
        <figure class="preview-item">
          <img id="preview-original" alt="原图预览" width="320" height="240" />
          <figcaption id="preview-original-caption">原图预览</figcaption>
        </figure>
        <figure class="preview-item">
          <img
            id="preview-converted"
            alt="转换后预览"
            width="320"
            height="240"
          />
          <figcaption id="preview-converted-caption">转换后预览</figcaption>
        </figure>
      </div>
      <p class="field-hint">
        转换在浏览器本地完成，图片不会上传；转换结果仅供参考。
      </p>
    </div>

    <div id="result" class="result" role="status" aria-live="polite">
      <p id="result-empty" class="result-empty">
        选择图片并点击「开始转换」查看结果
      </p>
      <div id="result-content" hidden>
        <p id="result-caption" class="result-caption">转换结果</p>
        <p id="result-main" class="result-main"></p>
        <p id="result-detail" class="result-process"></p>
        <p id="result-stale-hint" class="result-hint" hidden>
          参数或图片已变更，请重新转换
        </p>
        <div class="result-actions">
          <button type="button" id="copy-btn" class="btn btn-secondary" disabled
            >复制信息</button
          >
          <button
            type="button"
            id="download-btn"
            class="btn btn-primary"
            disabled>下载图片</button
          >
        </div>
      </div>
    </div>

    <AdContainer />
    <FaqSection items={faqItems} />
    <section class="section">
      <h2>相关工具</h2><ul class="tool-list">
        <li><a href="/efficiency/image-compress-cn/">图片压缩</a></li>
        <li><a href="/efficiency/qr-code-cn/">二维码生成器</a></li>
        <li><a href="/dev/base64/">Base64 编码解码计算器</a></li>
      </ul>
    </section>

    <CalcJsonLd
      name="图片格式转换"
      description={description}
      faqItems={faqItems}
    />
  </main>
  <script is:inline type="module" src="/scripts/image-convert-cn-page.js"
  ></script>
</BaseLayout>

<style>
  .dropzone {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    padding: 28px 16px;
    border: 2px dashed var(--border-color, #cbd5e1);
    border-radius: 12px;
    background: var(--surface-2, rgba(148, 163, 184, 0.08));
    cursor: pointer;
    text-align: center;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .dropzone:hover,
  .dropzone--active {
    border-color: var(--accent, #0f766e);
    background: var(--accent-soft, rgba(15, 118, 110, 0.08));
  }
  .dropzone__title {
    font-weight: 600;
  }
  .dropzone__hint {
    font-size: 0.85em;
    opacity: 0.75;
  }
  .dropzone__input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .quality-row {
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .quality-row input[type="range"] {
    flex: 1;
    min-width: 0;
  }
  .quality-value {
    width: 56px;
    flex: none;
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-size: 0.9em;
    opacity: 0.85;
  }
  .preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }
  .preview-item {
    margin: 0;
    text-align: center;
  }
  .preview-item img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    background: var(--surface-2, rgba(148, 163, 184, 0.12));
  }
  .preview-item figcaption {
    margin-top: 8px;
    font-size: 0.85em;
    overflow-wrap: anywhere;
    opacity: 0.8;
  }
</style>
