---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
const faqItems = [{ q: "中英文？", a: "中文按字符计数。" }, { q: "中文和英文分别怎么计数？", a: "中文字符按字计数，英文按连续字母串计为单词，数字串计为一个单词。" }, { q: "空格和换行算不算字符数？", a: "总字符数包含空格与换行；需要排除时请参考结果中的不含空格统计。" }];
---
<BaseLayout title="字数统计工具 — 在线统计中文字数英文单词与行数" description="免费在线字数统计：粘贴文本即时统计总字符数（含/不含空格）、中文字数、英文单词数、段落数与行数，适合作文限字、文案字数核对与字幕排版检查。" >
  <main id="main">
    <Breadcrumb items={[{label:"首页",href:"/"},{label:"效率工具"},{label:"字数统计计算器"}]} />
    <h1>字数统计计算器</h1>
    <p class="lead">字符 / 单词 / 段落 / 行数统计</p>
    
    <form id="calc-form" class="card" novalidate>
      <div class="field"><label for="text">文本</label><textarea id="text" class="field-input" rows="3" placeholder="Hello world 你好"></textarea><p class="field-error" id="field-error-text" hidden></p></div>
      <div class="form-actions"><button id="calc-btn" type="submit" class="btn btn-primary">计算</button><button id="reset-btn" type="button" class="btn btn-secondary">重置</button></div>
    </form>
    <div id="result" class="result" role="status" aria-live="polite"><p id="result-empty" class="result-empty">填写上方字段后显示结果</p><div id="result-content" hidden><p id="result-caption" class="result-caption"></p><p id="result-main" class="result-main"></p><p id="result-detail" class="result-process"></p><p id="result-stale-hint" class="result-hint" hidden>输入已变更，请重新计算</p><div class="result-actions"><button type="button" id="copy-btn" class="btn btn-secondary" disabled>复制结果</button></div></div></div>
    <AdContainer />
    <FaqSection items={faqItems} />
    <section class="section"><h2>相关工具</h2><ul class="tool-list">
  <li><a href="/daily/basic/">四则运算计算器</a></li>
  <li><a href="/efficiency/scientific-cn/">科学计算器</a></li>
  <li><a href="/dev/timestamp/">Unix 时间戳转换</a></li>
      </ul></section>
  
    <CalcJsonLd name="字数统计计算器" description="免费在线字数统计：粘贴文本即时统计总字符数（含/不含空格）、中文字数、英文单词数、段落数与行数，适合作文限字、文案字数核对与字幕排版检查。" faqItems={faqItems} />
  </main>
  <script is:inline type="module" src="/scripts/word-count-cn-page.js"></script>
</BaseLayout>
