---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";
const faqItems = [
  { q: "生成的密码会上传吗？", a: "不会。所有随机数与生成过程均在浏览器本地完成（使用 crypto.getRandomValues），密码不会经过任何网络传输。" },
  { q: "为什么没有 I/O/0/1 等字符？", a: "这些字符视觉上易混淆（如数字 0 与字母 O），我们主动从字符集中排除以提升可读性与输入准确率。" },
  { q: "最少/最长能生成多少位？", a: "支持 6~64 位。低于 6 位安全性不足，高于 64 位对一般账户注册场景已远超需求且难以记忆。" },
  { q: "应该选多长？", a: "普通账号密码推荐 16 位 + 全部 4 类字符；高安全场景（如主密码）推荐 32 位以上并配合密码管理器。" },
  { q: "和 Math.random() 有什么区别？", a: "本工具使用 crypto.getRandomValues（密码学安全伪随机数生成器），不会被外部预测；Math.random() 安全性不足，不能用于密码。" },
];
---
<BaseLayout title="随机密码生成器 — 本地生成高强度密码（不上传）" description="免费在线密码生成器：长度 6-64 位可调，支持大写、小写、数字、符号四类字符组合，使用 crypto.getRandomValues 密码学安全随机数，本地生成绝不上传。" >
  <main id="main">
    <Breadcrumb items={[{label:"首页",href:"/"},{label:"效率工具"},{label:"随机密码生成器"}]} />
    <h1>随机密码生成器</h1>
    <UsageGuide />
    <p class="lead">本地生成高强度密码 · 密码学安全随机 · 绝不上传</p>

    <form id="calc-form" class="card" novalidate>
      <div class="field">
        <label for="length">密码长度：<span id="length-val">16</span> 位</label>
        <input type="range" id="length" class="field-input" min="6" max="64" value="16" />
        <p class="field-error" id="field-error-length" hidden></p>
      </div>
      <div class="field checkline">
        <label for="upper"><input type="checkbox" id="upper" checked /> 大写字母（A-Z，排除 I/O）</label>
        <label for="lower"><input type="checkbox" id="lower" checked /> 小写字母（a-z，排除 l）</label>
        <label for="digit"><input type="checkbox" id="digit" checked /> 数字（2-9，排除 0/1）</label>
        <label for="symbol"><input type="checkbox" id="symbol" checked /> 符号（!@#$%^&*_+-=?）</label>
      </div>
      <div class="form-actions">
        <button id="calc-btn" type="submit" class="btn btn-primary">生成密码</button>
        <button id="reset-btn" type="button" class="btn btn-secondary">重置</button>
      </div>
    </form>

    <div id="result" class="result" role="status" aria-live="polite">
      <p id="result-empty" class="result-empty">点击「生成密码」按钮</p>
      <div id="result-content" hidden>
        <p id="result-caption" class="result-caption">您的密码</p>
        <p id="result-main" class="result-main"></p>
        <p id="result-detail" class="result-process"></p>
        <p id="result-stale-hint" class="result-hint" hidden>选项已变更，请重新生成</p>
        <div class="result-actions">
          <button type="button" id="copy-btn" class="btn btn-secondary" disabled>复制密码</button>
        </div>
      </div>
    </div>

    <p class="disclaimer">⚠️ 本结果由浏览器本地生成，<strong>不会上传到任何服务器</strong>。建议保存到密码管理器。</p>

    <AdContainer />
    <FaqSection items={faqItems} />
    <section class="section"><h2>相关工具</h2><ul class="tool-list">
      <li><a href="/efficiency/word-count-cn/">字数统计计算器</a></li>
      <li><a href="/efficiency/base-converter-cn/">进制转换计算器</a></li>
      <li><a href="/dev/timestamp/">Unix 时间戳转换</a></li>
    </ul></section>

    <CalcJsonLd name="随机密码生成器" description="免费在线密码生成器：长度 6-64 位可调，支持大写、小写、数字、符号四类字符组合，使用 crypto.getRandomValues 密码学安全随机数，本地生成绝不上传。" faqItems={faqItems} />
  </main>
  <script is:inline type="module" src="/scripts/password-generator-cn-page.js"></script>
</BaseLayout>