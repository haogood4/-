---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";
const faqItems = [
  { q: "转换原理是什么？", a: "内置常用简繁对照字库（2500 余对，源自开源 OpenCC 字典的常用字子集），在浏览器本地逐字转换，不依赖外部服务，文本不会上传。" },
  { q: "简转繁有什么局限？", a: "简→繁存在一对多：如「发」可对应「發/髮」、「干」可对应「幹/乾」、「后」可对应「後/后」。本工具按常用义优先做单字映射，不做词组级消歧，转换结果仅供参考，重要文本请人工复核。" },
  { q: "繁转简准确吗？", a: "繁→简基本上一对一（如「發/髮」都转回「发」），准确率较高，适合把繁体资料快速转为简体阅读。" },
  { q: "标点符号会转换吗？", a: "会。简体弯引号“ ”‘ ’与繁体直角引号「」『』互转；逗号、句号等两岸同码点标点保持不变。" },
  { q: "英文、数字会被改动吗？", a: "不会。非中文字符（英文、数字、空格、换行）原样透传；简繁同形的汉字（如「面」「中」）保持不变。" },
  { q: "为什么不内置完整 opencc 库？", a: "opencc 全量字典与分词消歧约 50KB 以上，超出本站单工具 JS 体积预算。本工具以约 8KB 的常用字子集覆盖日常文本，兼顾体积与效果。" },
  { q: "数据会上传吗？", a: "不会。所有转换在浏览器本地完成，文本内容不会离开您的设备。" },
];
---
<BaseLayout title="在线繁简转换工具 — 繁体简体互转" description="免费在线繁体简体转换工具：简体转繁体、繁体转简体双向互转，内置 2500 余对常用字库与标点转换，本地处理数据不上传，转换结果仅供参考。" >
  <main id="main">
    <Breadcrumb items={[{label:"首页",href:"/"},{label:"效率工具"},{label:"繁简转换工具"}]} />
    <h1>在线繁简转换工具</h1>
    <UsageGuide />
    <p class="lead">简体 ↔ 繁体 双向转换 · 本地处理 · 结果仅供参考</p>

    <form id="calc-form" class="card" novalidate>
      <div class="field">
        <label for="text">原文</label>
        <textarea id="text" class="field-input" rows="4" placeholder="把文本粘贴到这里…"></textarea>
        <p class="field-error" id="field-error-text" hidden></p>
      </div>
      <div class="form-actions">
        <button type="button" class="btn btn-secondary" data-dir="s2t">简→繁</button>
        <button type="button" class="btn btn-secondary" data-dir="t2s">繁→简</button>
        <button id="reset-btn" type="button" class="btn btn-secondary">清空</button>
      </div>
    </form>

    <div id="result" class="result" role="status" aria-live="polite">
      <p id="result-empty" class="result-empty">点击上方「简→繁」或「繁→简」按钮查看结果</p>
      <div id="result-content" hidden>
        <p id="result-caption" class="result-caption">转换结果</p>
        <p id="result-main" class="result-main"></p>
        <p id="result-detail" class="result-process"></p>
        <p id="result-stale-hint" class="result-hint" hidden>原文已变更，请重新转换</p>
        <div class="result-actions">
          <button type="button" id="copy-btn" class="btn btn-secondary" disabled>复制结果</button>
        </div>
      </div>
    </div>

    <AdContainer />
    <FaqSection items={faqItems} />
    <section class="section"><h2>相关工具</h2><ul class="tool-list">
      <li><a href="/efficiency/text-transform-cn/">文本处理工具</a></li>
      <li><a href="/efficiency/word-count-cn/">字数统计计算器</a></li>
      <li><a href="/efficiency/pinyin-cn/">汉字拼音转换工具</a></li>
    </ul></section>

    <CalcJsonLd name="在线繁简转换工具" description="免费在线繁体简体转换工具：简体转繁体、繁体转简体双向互转，内置 2500 余对常用字库与标点转换，本地处理数据不上传，转换结果仅供参考。" faqItems={faqItems} />
  </main>
  <script is:inline type="module" src="/scripts/chinese-convert-cn-page.js"></script>
</BaseLayout>
