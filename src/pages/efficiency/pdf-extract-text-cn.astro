---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ResultArea from "../../components/ResultArea.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import BreadcrumbJsonLd from "../../components/BreadcrumbJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";

const description =
  "在线 PDF 文字提取工具：把 PDF 中的文字完整提取出来，支持按页拆分输出，方便二次编辑与引用，本地处理不上传。完整功能开发中，当前提供接口契约与交互流程预览。";

const faqItems = [
  {
    q: "现在能提取 PDF 里的文字吗？",
    a: "还不能。完整提取功能正在开发中，当前页面提供接口契约与流程预览：可以选择文件并体验「按页拆分」选项，但文件不会被解析，也不会产生文字结果。",
  },
  {
    q: "「按页拆分输出」是什么意思？",
    a: "勾选后，上线版本的提取结果会按页码分段展示，方便对照原文定位；不勾选则把全部文字合并为一段连续文本，适合直接复制到编辑器。",
  },
  {
    q: "扫描版 PDF 能提取吗？",
    a: "扫描版 PDF 的内容是图片而非文字，纯文本提取无法得到结果。上线版本会明确提示「未发现可提取文字」，此类文件建议先转图片再借助 OCR 方案。",
  },
  {
    q: "文件会被上传吗？",
    a: "不会。本工具设计为全程浏览器本地处理，当前版本同样不读取、不上传任何文件内容。",
  },
];
---

<BaseLayout
  title="PDF 文字提取工具 — 在线提取 PDF 中的文字（完整功能开发中）"
  description={description}
>
  <main id="main">
    <Breadcrumb
      items={[
        { label: "首页", href: "/" },
        { label: "效率工具" },
        { label: "PDF 文字提取工具" },
      ]}
    />
    <h1>PDF 文字提取工具</h1>
    <UsageGuide />
    <p class="lead">
      提取 PDF 文字 · 支持按页拆分输出 · 本地处理不上传 · 完整功能开发中
    </p>
    <p class="ymyl-notice" role="note">
      <strong>⚖️ 使用须知</strong>：请<strong>仅提取您拥有合法权利或已获授权的 PDF 文字内容</strong>。<strong>请勿使用本工具提取他人享有版权的文档、内部资料、个人隐私文件（含他人身份证 / 合同 / 病历 / 票据等）</strong>，避免侵犯他人著作权或个人信息权益。本工具为中立技术工具，PDF 完整功能上线后全程在浏览器本地处理、不上传服务器。
    </p>

    <section class="section" aria-label="功能状态说明">
      <div class="card">
        <p>
          <strong>诚实声明：完整功能开发中，暂提供接口契约。</strong>
          本页当前展示未来版本的操作流程与接口契约，PDF 处理引擎尚未接入，文件不会被解析、提取或上传。
        </p>
      </div>
    </section>

    <form id="calc-form" class="card" novalidate aria-label="PDF 文字提取表单">
      <div class="field">
        <label for="pdf-input">选择 PDF 文件</label>
        <input
          type="file"
          id="pdf-input"
          class="field-input"
          accept="application/pdf,.pdf"
        />
        <p class="field-hint">当前版本不会读取文件内容。</p>
        <p class="field-error" id="field-error-file" hidden></p>
      </div>
      <div class="field">
        <label for="per-page">
          <input type="checkbox" id="per-page" />
          按页拆分输出（逐页分段展示）
        </label>
      </div>
      <div class="form-actions">
        <button id="calc-btn" type="submit" class="btn btn-primary"
          >提取文字</button
        >
        <button id="reset-btn" type="button" class="btn btn-secondary"
          >重置</button
        >
      </div>
    </form>

    <ResultArea />

    <AdContainer />

    <section class="section" aria-labelledby="usage-heading">
      <h2 id="usage-heading">使用说明（完整功能上线后）</h2>
      <ol class="note-list">
        <li>选择 1 个需要提取文字的 PDF 文件。</li>
        <li>按需勾选「按页拆分输出」。</li>
        <li>点击「提取文字」，本地解析后复制或下载提取结果。</li>
      </ol>
    </section>

    <FaqSection items={faqItems} />

    <section class="section">
      <h2>相关工具</h2><ul class="tool-list">
        <li><a href="/efficiency/pdf-merge-cn/">PDF 合并工具</a></li>
        <li><a href="/efficiency/word-count-cn/">字数统计计算器</a></li>
        <li>
          <a href="/efficiency/text-similarity-cn/">文本相似度对比工具</a>
        </li>
        <li><a href="/efficiency/pdf-split-cn/">PDF 拆分工具</a></li>
      </ul>
    </section>

    <CalcJsonLd
      name="PDF 文字提取工具"
      description={description}
      faqItems={faqItems}
    />
    <BreadcrumbJsonLd
      items={[
        { name: "首页", href: "/" },
        { name: "效率工具" },
        { name: "PDF 文字提取工具" },
      ]}
    />
  </main>

  <script is:inline type="module" src="/scripts/pdf-extract-text-cn-page.js"
  ></script>
</BaseLayout>
