---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";
const faqItems = [{ q: "CIDR？", a: "子网掩码中 1 的位数。" }, { q: "子网掩码和 CIDR 有什么区别？", a: "子网掩码是 32 位点分表示（如 255.255.255.0），CIDR 是前缀长度记法（/24），两者等价可互转。" }, { q: "为什么可用主机数要减 2？", a: "主机位全 0 为网络地址、全 1 为广播地址，均不可分配给主机；/31 点对点链路是例外。" }];
---
<BaseLayout title="IP 子网计算器 — 在线子网掩码 CIDR 可用主机数查询" description="免费在线 IP 子网划分计算器：输入 IP 地址与 CIDR 前缀长度，即时得出网络地址、广播地址、子网掩码、可用主机数与地址范围，网络工程师与计算机网络学习必备。" >
  <main id="main">
    <Breadcrumb items={[{label:"首页",href:"/"},{label:"效率工具"},{label:"IP 子网计算器"}]} />
    <h1>IP 子网计算器</h1>
    <UsageGuide />
    <p class="lead">IP 子网掩码 / 可用主机数 / CIDR</p>
    
    <form id="calc-form" class="card" novalidate>
      <div class="field"><label for="ip">IP 地址</label><input id="ip" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="192.168.1.0" /><p class="field-error" id="field-error-ip" hidden></p></div>
      <div class="field"><label for="cidr">CIDR（0-32）</label><input id="cidr" class="field-input" type="text" inputmode="decimal" autocomplete="off" placeholder="24" /><p class="field-error" id="field-error-cidr" hidden></p></div>
      <div class="form-actions"><button id="calc-btn" type="submit" class="btn btn-primary">计算</button><button id="reset-btn" type="button" class="btn btn-secondary">重置</button></div>
    </form>
    <div id="result" class="result" role="status" aria-live="polite"><p id="result-empty" class="result-empty">填写上方字段后显示结果</p><div id="result-content" hidden><p id="result-caption" class="result-caption"></p><p id="result-main" class="result-main"></p><p id="result-detail" class="result-process"></p><p id="result-stale-hint" class="result-hint" hidden>输入已变更，请重新计算</p><div class="result-actions"><button type="button" id="copy-btn" class="btn btn-secondary" disabled>复制结果</button></div></div></div>
    <AdContainer />
    <FaqSection items={faqItems} />
    <section class="section"><h2>相关工具</h2><ul class="tool-list">
  <li><a href="/efficiency/base-converter-cn/">进制转换计算器</a></li>
  <li><a href="/efficiency/scientific-cn/">科学计算器</a></li>
  <li><a href="/dev/timestamp/">Unix 时间戳转换</a></li>
      </ul></section>
  
    <CalcJsonLd name="IP 子网计算器" description="免费在线 IP 子网划分计算器：输入 IP 地址与 CIDR 前缀长度，即时得出网络地址、广播地址、子网掩码、可用主机数与地址范围，网络工程师与计算机网络学习必备。" faqItems={faqItems} />
  </main>
  <script is:inline type="module" src="/scripts/ip-subnet-cn-page.js"></script>
</BaseLayout>
