---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import AdContainer from "../../components/AdContainer.astro";
import FaqSection from "../../components/FaqSection.astro";
import CalcJsonLd from "../../components/CalcJsonLd.astro";
import BreadcrumbJsonLd from "../../components/BreadcrumbJsonLd.astro";
import UsageGuide from "../../components/UsageGuide.astro";

const description =
  "免费在线图片改尺寸工具：按宽度或高度等比缩放，也可精确指定宽高，输出 JPG/PNG/WebP，浏览器本地 Canvas 处理不上传。与图片压缩（压体积）、格式转换（转格式）定位不同，专为改尺寸设计。";

const faqItems = [
  {
    q: "改尺寸和图片压缩工具有什么区别？",
    a: "本工具以「指定目标宽/高」为核心：按宽度或高度等比缩放，或精确指定宽高（可能变形）。若只想压小体积而不关心像素尺寸，请用图片压缩工具；只换格式不改尺寸请用格式转换工具。",
  },
  {
    q: "「按宽度/按高度」和「精确宽高」怎么选？",
    a: "按宽度缩放时高度按原图比例自动换算，不会变形，适合统一排版宽度；精确宽高则完全按输入值输出，宽高比与原图不一致时画面会被拉伸变形，慎用。",
  },
  {
    q: "图片会上传到服务器吗？",
    a: "不会。缩放全程在您的浏览器内用 Canvas 本地完成，图片数据不经过任何服务器，也不会被保存。",
  },
  {
    q: "支持哪些格式和尺寸上限？",
    a: "支持 PNG、JPEG、WebP 三种输入，单张不超过 10MB；目标宽/高范围为 1~10000 像素；输出可选 JPG、PNG 或 WebP。",
  },
  {
    q: "为什么 PNG 缩放后选择 JPG 会变大？",
    a: "PNG 含透明通道时转 JPG 会垫白底；若缩放后图片内容简单，JPG 体积可能反而更大，可预览对比后改用 PNG 或 WebP 输出。",
  },
];
---

<BaseLayout
  title="在线图片改尺寸工具 — 等比/精确缩放 JPG/PNG/WebP（本地处理）"
  description={description}
>
  <main id="main">
    <Breadcrumb
      items={[
        { label: "首页", href: "/" },
        { label: "效率工具" },
        { label: "在线图片改尺寸" },
      ]}
    />
    <h1>在线图片改尺寸工具</h1>
    <UsageGuide />
    <p class="lead">
      按宽/高等比缩放或精确指定 · 输出 JPG/PNG/WebP · 本地处理不上传
    </p>

    <form id="calc-form" class="card" novalidate aria-label="图片改尺寸表单">
      <div class="field">
        <label for="file-input">选择图片</label>
        <label class="dropzone" id="dropzone" for="file-input">
          <span class="dropzone__title">把图片拖到这里，或点击选择文件</span>
          <span class="dropzone__hint"
            >支持 PNG / JPEG / WebP，单张不超过 10MB</span
          >
          <input
            type="file"
            id="file-input"
            class="dropzone__input"
            accept="image/png,image/jpeg,image/webp"
          />
        </label>
        <p class="field-hint" id="file-info" hidden></p>
        <p class="field-error" id="field-error-file" hidden></p>
      </div>
      <div class="field">
        <label for="resize-mode">缩放模式</label>
        <select id="resize-mode" class="field-select">
          <option value="by-width" selected
            >按宽度等比缩放（高度自动换算）</option
          >
          <option value="by-height">按高度等比缩放（宽度自动换算）</option>
          <option value="exact">精确指定宽高（不保持比例，可能变形）</option>
        </select>
      </div>
      <div class="field">
        <label for="target-width">目标宽度（1 ~ 10000 像素）</label>
        <input
          type="number"
          id="target-width"
          class="field-input"
          min="1"
          max="10000"
          step="1"
          value="800"
        />
        <p class="field-error" id="field-error-width" hidden></p>
      </div>
      <div class="field">
        <label for="target-height">目标高度（1 ~ 10000 像素）</label>
        <input
          type="number"
          id="target-height"
          class="field-input"
          min="1"
          max="10000"
          step="1"
          value="600"
        />
        <p class="field-error" id="field-error-height" hidden></p>
      </div>
      <div class="field">
        <label for="output-format">输出格式</label>
        <select id="output-format" class="field-select">
          <option value="image/jpeg" selected
            >JPG（体积小，透明区域垫白底）</option
          >
          <option value="image/png">PNG（无损，保留透明）</option>
          <option value="image/webp">WebP（体积小，保留透明）</option>
        </select>
      </div>
      <div class="form-actions">
        <button id="calc-btn" type="submit" class="btn btn-primary"
          >开始改尺寸</button
        >
        <button id="reset-btn" type="button" class="btn btn-secondary"
          >重置</button
        >
      </div>
    </form>

    <div class="card" id="preview-card">
      <div class="preview-grid">
        <figure class="preview-item">
          <img id="preview-original" alt="原图预览" width="320" height="240" />
          <figcaption id="preview-original-caption">原图预览</figcaption>
        </figure>
        <figure class="preview-item">
          <img
            id="preview-resized"
            alt="改尺寸后预览"
            width="320"
            height="240"
          />
          <figcaption id="preview-resized-caption">处理后预览</figcaption>
        </figure>
      </div>
      <p class="field-hint">
        缩放在浏览器本地完成，图片不会上传；体积变化与显示效果仅供参考。
      </p>
    </div>

    <div id="result" class="result" role="status" aria-live="polite">
      <p id="result-empty" class="result-empty">
        选择图片并点击「开始改尺寸」查看结果
      </p>
      <div id="result-content" hidden>
        <p id="result-caption" class="result-caption">改尺寸结果</p>
        <p id="result-main" class="result-main"></p>
        <p id="result-process" class="result-process"></p>
        <p id="result-stale-hint" class="result-hint" hidden>
          参数或图片已变更，请重新处理
        </p>
        <div class="result-actions">
          <button type="button" id="copy-btn" class="btn btn-secondary" disabled
            >复制结果</button
          >
          <button
            type="button"
            id="share-btn"
            class="btn btn-secondary"
            disabled>分享工具</button
          >
          <button
            type="button"
            id="download-btn"
            class="btn btn-primary"
            disabled>下载图片</button
          >
        </div>
      </div>
    </div>

    <AdContainer />

    <section class="section" aria-labelledby="usage-heading">
      <h2 id="usage-heading">使用说明</h2>
      <ol class="note-list">
        <li>拖拽或点击选择一张 PNG/JPEG/WebP 图片。</li>
        <li>选择缩放模式并填写目标宽或高（按宽度模式只需填宽度）。</li>
        <li>点击「开始改尺寸」，预览确认后点击「下载图片」保存。</li>
      </ol>
    </section>

    <section class="section" aria-labelledby="rule-heading">
      <h2 id="rule-heading">缩放规则</h2>
      <ul class="formula-list">
        <li class="formula-item">
          <p>
            等比模式：目标高 = 原高 × (目标宽 ÷ 原宽)，四舍五入且至少 1
            像素，画面不变形。
          </p>
        </li>
        <li class="formula-item">
          <p>
            精确模式：宽高完全按输入值输出，Canvas
            直接重绘，宽高比与原图不一致时会产生拉伸变形。
          </p>
        </li>
      </ul>
    </section>

    <FaqSection items={faqItems} />

    <section class="section">
      <h2>相关工具</h2><ul class="tool-list">
        <li><a href="/efficiency/image-compress-cn/">在线图片压缩工具</a></li>
        <li><a href="/efficiency/image-convert-cn/">图片格式转换工具</a></li>
        <li>
          <a href="/efficiency/image-watermark-cn/">在线图片加水印工具</a>
        </li>
        <li>
          <a href="/efficiency/image-idphoto-cn/">在线证件照换底色工具</a>
        </li>
      </ul>
    </section>

    <CalcJsonLd
      name="在线图片改尺寸工具"
      description={description}
      faqItems={faqItems}
    />
    <BreadcrumbJsonLd
      items={[
        { name: "首页", href: "/" },
        { name: "效率工具" },
        { name: "在线图片改尺寸" },
      ]}
    />
  </main>

  <script is:inline type="module" src="/scripts/image-resize-cn-page.js"
  ></script>
</BaseLayout>

<style>
  .dropzone {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    padding: 28px 16px;
    border: 2px dashed var(--border-color, #cbd5e1);
    border-radius: 12px;
    background: var(--surface-2, rgba(148, 163, 184, 0.08));
    cursor: pointer;
    text-align: center;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .dropzone:hover,
  .dropzone--active {
    border-color: var(--accent, #0f766e);
    background: var(--accent-soft, rgba(15, 118, 110, 0.08));
  }
  .dropzone__title {
    font-weight: 600;
  }
  .dropzone__hint {
    font-size: 0.85em;
    opacity: 0.75;
  }
  .dropzone__input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }
  .preview-item {
    margin: 0;
    text-align: center;
  }
  .preview-item img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    background: var(--surface-2, rgba(148, 163, 184, 0.12));
  }
  .preview-item figcaption {
    margin-top: 8px;
    font-size: 0.85em;
    overflow-wrap: anywhere;
    opacity: 0.8;
  }
</style>
