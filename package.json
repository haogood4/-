{
  "name": "calculator-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-public-scripts.mjs && astro build",
    "preview": "astro preview",
    "test:run": "vitest run",
    "typecheck": "node ./node_modules/typescript-v7/bin/tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check src '!scripts/fix-*' '!scripts/remove-*' '!scripts/generate-*' '!scripts/final-fix.mjs'",
    "mcp:check": "node scripts/check-mcp-json.mjs",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "smoke": "node scripts/smoke-dist.mjs",
    "astro:probe": "node scripts/check-astro-fix.mjs",
    "verify:dist": "pnpm build && pnpm smoke",
    "predeploy": "node scripts/check-site-url.mjs && pnpm verify",
    "predeploy:report": "node scripts/check-site-url.mjs && node -e \"const o={timestamp:new Date().toISOString(),site:process.env.PUBLIC_SITE_URL||'(未设置)',node:process.version,pnpm:'>=9',astro:require('astro/package.json').version};console.log(JSON.stringify(o,null,2))\"",
    "deploy": "pnpm predeploy && astro build && wrangler pages deploy dist --project-name calculator-site",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:run && pnpm format:check && pnpm mcp:check && pnpm bundle:check"
  },
  "devDependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/js": "^10.0.1",
    "astro": "^7.3.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "isomorphic-dompurify": "^4.2.0",
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "typescript-v7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "dependencies": {
    "marked": "^18.0.13"
  }
}
