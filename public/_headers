# HTML：不缓存副本，每次协商（Cloudflare Pages 自动附带 ETag/Last-Modified，304 重验证开销极小）
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: public, max-age=0, must-revalidate

# 带内容哈希的构建产物：一年强缓存 + immutable（文件名变更即新 URL，无需重验证）
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 共享 JS chunk（esbuild kit-[hash] 产物，同上可强缓存）
/scripts/kit-*
  Cache-Control: public, max-age=31536000, immutable

# Service Worker：必须每次检查更新，否则新版本无法下发
/sw.js
  Cache-Control: no-cache

/register-sw.js
  Cache-Control: no-cache

# 站点级静态文件：短缓存
/robots.txt
  Cache-Control: public, max-age=86400

/sitemap-*.xml
  Cache-Control: public, max-age=3600

/sitemap-index.xml
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=604800

/og-image.svg
  Cache-Control: public, max-age=604800

/og-image.png
  Cache-Control: public, max-age=604800
